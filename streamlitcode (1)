# === RISK / Cost velocity ===
def render_velocity():
    section_header(
        "Cost velocity",
        "Daily service credits versus that service's own 7-day rolling average. Velocity 2x means that day ran twice the recent daily rate.",
        period="Each row is one service on one day — not a monthly total, not lifetime",
    )

    df_vel = run_query("VW_COST_VELOCITY")
    if not df_vel.empty:
        df_vel = clean_dates(df_vel, ["USAGE_DATE"])
        drift_col = get_best_col(df_vel, ["DRIFT_STATUS", "STATUS"])
        svc_col = get_best_col(df_vel, ["SERVICE_TYPE", "SERVICE"])
        vel_col = get_best_col(df_vel, ["VELOCITY"])
        cred_col = get_best_col(df_vel, ["DAILY_CREDITS", "CREDITS"])

        if drift_col:
            incidents = df_vel[df_vel[drift_col].isin(["SPIKE", "ACCELERATING"])].copy()
            spikes = df_vel[df_vel[drift_col] == "SPIKE"]
            accelerating = df_vel[df_vel[drift_col] == "ACCELERATING"]

            worst_incident = None
            if not incidents.empty and vel_col:
                incidents = incidents.sort_values(vel_col, ascending=False)
                worst_incident = incidents.iloc[0]

            # Uniform KPI row — every card carries a value + delta
            col_v1, col_v2, col_v3, col_v4 = st.columns(4)
            with col_v1:
                st.metric("Total Incidents", f"{len(incidents)}",
                          delta="Requires review" if len(incidents) > 0 else "All clear",
                          delta_color="inverse" if len(incidents) > 0 else "normal")
            with col_v2:
                st.metric("Spike Events", f"{len(spikes)}",
                          delta="Above threshold" if len(spikes) > 0 else "None",
                          delta_color="inverse" if len(spikes) > 0 else "normal")
            with col_v3:
                acc_n = accelerating[svc_col].nunique() if svc_col else len(accelerating)
                st.metric("Accelerating Services", f"{acc_n}",
                          delta="Trending up" if acc_n > 0 else "Stable",
                          delta_color="inverse" if acc_n > 0 else "normal")
            with col_v4:
                if worst_incident is not None:
                    st.metric("Peak Velocity", f"{safe_num(worst_incident[vel_col]):.2f}x",
                              delta=str(worst_incident[svc_col])[:20] if svc_col else "—",
                              delta_color="inverse")
                else:
                    st.metric("Peak Velocity", "—", delta="No spikes", delta_color="normal")

            if worst_incident is not None:
                st.error(
                    f"**Primary culprit:** `{worst_incident[svc_col] if svc_col else 'unknown'}` on "
                    f"**{worst_incident.get('USAGE_DATE', '-')}** consumed "
                    f"**{safe_num(worst_incident[cred_col]) if cred_col else 0:.2f} credits** — "
                    f"{safe_num(worst_incident[vel_col]):.2f}x its 7-day rolling average."
                )

            st.markdown("#### Credit Usage Spikes")
            if not incidents.empty:
                inc_cols = [c for c in ["USAGE_DATE", svc_col, cred_col, "ROLLING_AVG_7D",
                                        vel_col, "ACCELERATION", drift_col]
                            if c and c in incidents.columns]
                show_table(axis_label(incidents[inc_cols], {
                    "USAGE_DATE": "Date", svc_col: "Service", cred_col: "Daily Credits",
                    "ROLLING_AVG_7D": "7-Day Avg", vel_col: "Velocity",
                    "ACCELERATION": "Acceleration", drift_col: "Status",
                }))
                st.caption("Velocity = daily credits / 7-day rolling average. Values above 1.0 mean spend is running hot.")
            else:
                st.success("No spike or acceleration incidents in the analysis window.")

        st.markdown("#### Consumption Trajectory")
        vel_grain = drill_control("vel_grain", default="Date")
        vel_chart = apply_drill(df_vel, "USAGE_DATE", [cred_col], vel_grain, group_col=svc_col, drill_key="vel_grain")
        vel_chart = axis_label(vel_chart, {"USAGE_DATE": vel_grain, cred_col: "Credits",
                                           svc_col: "Service"})
        safe_render_chart("line", vel_chart, [vel_grain], ["Credits"], ["Service"])

        with st.expander("Full velocity history (all days, highest velocity first)"):
            show_table(axis_label(
                df_vel.sort_values(vel_col, ascending=False) if vel_col else df_vel,
                {"USAGE_DATE": "Date", svc_col: "Service", cred_col: "Daily Credits",
                 "ROLLING_AVG_7D": "7-Day Avg", vel_col: "Velocity",
                 "ACCELERATION": "Acceleration", drift_col: "Status"}
            ))
    else:
        st.caption("No velocity data available.")


