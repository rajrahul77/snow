    idle = _overview_idle(raw_idle, month, summary["cutoff"])
    wh_period = _overview_month(warehouse, month, summary["cutoff"])
    wh_summary = _overview_summary(warehouse, month, today)
    services = _overview_rank(summary["valid"], get_best_col(summary["valid"], ["SERVICE_TYPE", "SERVICE"], default_index=None))
    warehouses = _overview_rank(wh_period, get_best_col(wh_period, ["WAREHOUSE_NAME"], default_index=None))
    if summary["total"] is None:
        services = services.iloc[:0]
    if wh_summary["total"] is None or wh_meta["invalid"]:
        warehouses = warehouses.iloc[:0]
    used_pct = summary["total"] / target * 100 if target > 0 and summary["total"] is not None else None
    projected_gap = summary["projection"] - target if target > 0 and summary["projection"] is not None else None

    spend_note = f"{summary['delta']:+.1f}% vs same days last month" if summary["delta"] is not None else "Comparison unavailable"
