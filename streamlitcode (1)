def build_action_plan(df_waste, df_anom, df_active, df_spcs, df_topq, credit_price_usd):
    rows = []
    if df_waste is not None and not df_waste.empty:
        for _, row in df_waste.iterrows():
            wh = str(row.get("WAREHOUSE_NAME", "Warehouse"))
            credits = safe_num(row.get("CREDITS_14D", 0))
            score = safe_num(row.get("EFFICIENCY_SCORE", 100))
            util = safe_num(row.get("UTILIZATION_PCT", 100))
            spill = safe_num(row.get("SPILL_PCT", 0))
            scan = safe_num(row.get("FULL_SCAN_PCT", 0))
            queue = safe_num(row.get("QUEUE_PCT", 0))
            if score < 70 and credits > 0:
                rows.append(["High" if score < 55 else "Medium", "Warehouse efficiency", wh, f"Efficiency {score:.0f}/100 on {credits:.1f} credits", "Tune auto-suspend, rightsize, and isolate noisy workloads.", credits])
            if util < 20 and credits > 0:
                rows.append(["High", "Idle compute", wh, f"Only {util:.1f}% active-hour utilization", "Set AUTO_SUSPEND to 60 seconds and review schedule-based shutdown.", credits])
            if spill > 5:
                rows.append(["Medium", "Performance waste", wh, f"{spill:.1f}% of queries spill to disk", "Resize memory-heavy jobs or rewrite high-cardinality joins.", credits])
            if scan > 50:
                rows.append(["Medium", "Scan waste", wh, f"{scan:.1f}% full table scans", "Add clustering/search optimization for repeatedly scanned tables.", credits])
            if queue > 10:
                rows.append(["Medium", "Concurrency", wh, f"{queue:.1f}% queued queries", "Enable multi-cluster scaling or separate interactive and batch workloads.", credits])

    if df_active is not None and not df_active.empty:
        for _, row in df_active.iterrows():
            status = str(row.get("STATUS_RECOMMENDATION", "")).upper()
            if "UNUSED" in status or "IDLE" in status:
                rows.append([
                    "High" if "UNUSED" in status else "Medium",
                    "Resource hygiene",
                    str(row.get("RESOURCE_NAME", "Resource")),
                    str(row.get("STATUS_RECOMMENDATION", "Idle resource")),
                    "Confirm ownership, suspend unused resources, and remove stale schedules.",
                    safe_num(row.get("CREDITS_7D", 0)),
                ])

    if df_spcs is not None and not df_spcs.empty and "COMPUTE_POOL_NAME" in df_spcs.columns:
        pools = df_spcs.groupby("COMPUTE_POOL_NAME", as_index=False).agg(
            {"PROJECTED_MONTHLY_CREDITS": "max", "LIFETIME_CREDITS": "max"}
        )
        for _, row in pools.nlargest(5, "PROJECTED_MONTHLY_CREDITS").iterrows():
            projected = safe_num(row.get("PROJECTED_MONTHLY_CREDITS", 0))
            if projected > 0:
                rows.append([
                    "High" if projected >= 25 else "Medium",
                    "Container services",
                    str(row.get("COMPUTE_POOL_NAME", "Compute pool")),
                    f"Projected {projected:.1f} credits this month",
                    "Introduce start/stop policy and owner-level chargeback.",
                    projected,
                ])

    if df_anom is not None and not df_anom.empty and "ANOMALY_FLAG" in df_anom.columns:
        spikes = df_anom[df_anom["ANOMALY_FLAG"].astype(str).str.upper() == "SPIKE"].copy()
        if "Z_SCORE" in spikes.columns:
            spikes = spikes.sort_values("Z_SCORE", ascending=False)
        for _, row in spikes.head(5).iterrows():
            rows.append([
                "High",
                "Anomaly response",
                str(row.get("WAREHOUSE_NAME", "Warehouse")),
                f"{safe_num(row.get('DAILY_CREDITS', 0)):.2f} credits on {row.get('USAGE_DATE', '-')}",
                "Review deployment, user, or job change that caused the spike.",
                safe_num(row.get("DAILY_CREDITS", 0)),
            ])

    if df_topq is not None and not df_topq.empty:
        costly = df_topq.nlargest(5, "ESTIMATED_CREDITS") if "ESTIMATED_CREDITS" in df_topq.columns else df_topq.head(5)
        for _, row in costly.iterrows():
            credits = safe_num(row.get("ESTIMATED_CREDITS", 0))
            if credits > 0:
                rows.append([
                    "Medium",
                    "Query optimization",
                    str(row.get("USER_NAME", "User")),
                    f"{credits:.4f} credits, {safe_num(row.get('GB_SCANNED', 0)):.1f} GB scanned",
                    "Inspect query profile, pruning, joins, and warehouse size.",
                    credits,
                ])

    if not rows:
        return pd.DataFrame()
    out = pd.DataFrame(rows, columns=["Priority", "Area", "Target", "Signal", "Recommended Action", "Impact Credits"])
    rank = {"High": 0, "Medium": 1, "Low": 2}
    out["_rank"] = out["Priority"].map(rank).fillna(9)
    out = out.sort_values(["_rank", "Impact Credits"], ascending=[True, False]).drop(columns=["_rank"])
    out["Estimated USD"] = (out["Impact Credits"] * credit_price_usd).round(2)
    return out


