def fmt_month(df, cols=None):
    """Renders month columns as MM/YYYY."""
    if df is None or df.empty:
        return df
    df = df.copy()
    targets = cols if cols else [c for c in df.columns if c.upper() in ("MONTH", "MONTH_START", "ORDER_MONTH")]
    for col in targets:
        if col not in df.columns:
            continue
        try:
            raw = df[col].astype(str).str.replace('"', '', regex=False).str.strip()
            parsed = pd.to_datetime(raw, errors="coerce")
            if parsed.notna().any():
                df[col] = parsed.dt.strftime("%m/%Y").fillna("")
        except Exception:
            pass
    return df


