# Pure helpers keep reporting definitions reviewable inside this monolith.
def _overview_number(value):
    try:
        number = float(value)
        return number if pd.notna(number) and abs(number) != float("inf") else None
    except (TypeError, ValueError, OverflowError):
        return None


def _overview_amount(value):
    """Unknown stays unknown; small, nonzero usage never rounds to zero."""
    number = _overview_number(value)
    if number is None:
        return "Not available"
    if show_usd():
        number *= credit_rate()
    magnitude = abs(number)
    if 0 < magnitude < 0.0001:
        text = f"{number:.2g}"
    elif magnitude < 1:
        text = f"{number:.4f}".rstrip("0").rstrip(".") if number else "0"
    else:
        text = f"{number:,.2f}"
    return f"${text}" if show_usd() else f"{text} cr"


def _overview_source(df, credit_candidates):
    """Do not substitute a random column, coerce missing credits to zero, or fill gaps."""
    date_col = get_best_col(df, ["USAGE_DATE", "DATE", "START_TIME"], default_index=None)
    credit_col = get_best_col(df, credit_candidates, default_index=None)
    if not date_col or not credit_col:
        return pd.DataFrame(), {"invalid": 0, "contract": False}
    out = df.copy()
    out["_day"] = pd.to_datetime(out[date_col], errors="coerce", utc=True).dt.normalize()
    out["_credits"] = pd.to_numeric(out[credit_col], errors="coerce")
    valid = out["_day"].notna() & out["_credits"].notna() & out["_credits"].ge(0)
    valid &= ~out["_credits"].isin([float("inf"), -float("inf")])
    out["_valid"] = valid
    return out, {"invalid": int((~valid).sum()), "contract": True}


def _overview_month(df, month, through=None):
    if df.empty or "_day" not in df:
        return df.iloc[:0].copy()
    dates = df["_day"].dt.strftime("%Y-%m")
    mask = dates.eq(month)
    if through is not None:
        mask &= df["_day"].le(through)
    return df.loc[mask].copy()


def _overview_summary(df, month, today=None):
    """Calendar-aligned comparisons and a guarded, explicitly derived pace scenario."""
    today = pd.Timestamp(today if today is not None else datetime.now(timezone.utc))
    today = today.tz_localize("UTC") if today.tzinfo is None else today.tz_convert("UTC")
    today = today.normalize()
    start = pd.Timestamp(f"{month}-01", tz="UTC")
    end = start + pd.offsets.MonthEnd(0)
    current = start.strftime("%Y-%m") == today.strftime("%Y-%m")
    period = _overview_month(df, month, through=today)
    dated = period["_day"].dropna() if not period.empty else pd.Series(dtype="datetime64[ns, UTC]")
    latest = dated.max() if not dated.empty else None
    cutoff = latest if current and latest is not None else min(end, today)
    expected = max(0, int((cutoff - start).days) + 1)
    valid = period.loc[period["_valid"]].copy() if not period.empty else period
    unknown_dates = not df.empty and bool(df["_day"].isna().any())
    bad = int((~period["_valid"]).sum()) if not period.empty else 0
    service_col = get_best_col(period, ["SERVICE_TYPE", "SERVICE"], default_index=None)
    duplicate = bool(period.duplicated(["_day", service_col]).any()) if service_col else False
    daily = valid.groupby("_day")["_credits"].sum().sort_index() if not valid.empty else pd.Series(index=pd.DatetimeIndex([], tz="UTC"), dtype=float)
    reliable = not period.empty and not bad and not unknown_dates and not duplicate
    total = float(daily.sum()) if reliable and not daily.empty else None
    day_count = len(daily)
    prefix_complete = reliable and day_count == expected and expected > 0
    prior_start = start - pd.offsets.MonthBegin(1)
    prior_end = prior_start + pd.offsets.MonthEnd(0)
    prior = _overview_month(df, prior_start.strftime("%Y-%m"), through=prior_start + pd.Timedelta(days=max(expected - 1, 0)))
    comparable = expected > 0 and expected <= prior_end.day and prefix_complete and cutoff < today
    comparable &= not prior.empty and bool(prior["_valid"].all())
    comparable &= prior["_day"].nunique() == expected if not prior.empty else False
    if service_col and service_col in prior:
        comparable &= not bool(prior.duplicated(["_day", service_col]).any())
    prior_total = float(prior["_credits"].sum()) if comparable else None
    delta = (total - prior_total) / prior_total * 100 if comparable and prior_total > 0 else None
    # Early-month outlook can use the previous month's last days, provided all
    # seven calendar days are recorded. Never divide seven sparse observations by seven.
    recent_rows = df.loc[df["_day"].ge(cutoff - pd.Timedelta(days=6)) & df["_day"].le(cutoff)].copy() if not df.empty else df
    recent = recent_rows.loc[recent_rows["_valid"]].groupby("_day")["_credits"].sum() if not recent_rows.empty else pd.Series(dtype=float)
    recent_valid = not recent_rows.empty and bool(recent_rows["_valid"].all())
    if service_col and service_col in recent_rows:
        recent_valid &= not bool(recent_rows.duplicated(["_day", service_col]).any())
    pace = float(recent.sum()) / 7 if len(recent) == 7 and reliable and recent_valid else None
    projection = None
    if not current:
        reason = "Historical month: see recorded spend; no forward estimate."
    elif total is None:
        reason = "No trustworthy monthly total is available."
    elif not prefix_complete:
        reason = "Missing calendar-day records; projection withheld."
    elif cutoff >= today:
        reason = "Latest day may be partial; projection withheld."
    elif (today - cutoff).days > 3:
        reason = "Source observation is over 3 days old; projection withheld."
    elif pace is None:
        reason = "At least 7 consecutive recorded days are needed."
    else:
        projection = total + pace * int((end - cutoff).days)
        reason = "7-day pace scenario; assumes unchanged activity."
    return {"period": period, "valid": valid, "daily": daily, "total": total,
            "prior": prior, "prior_total": prior_total, "comparable": bool(comparable),
            "delta": delta, "pace": pace, "projection": projection, "forecast_note": reason,
            "start": start, "end": end, "cutoff": cutoff, "latest": latest,
            "days": day_count, "expected": expected, "complete": bool(prefix_complete),
            "current": current, "invalid": bad, "unknown_dates": unknown_dates,
            "duplicates": duplicate}


def _overview_anomaly_scan(df):
    """Recognized event flags are distinct from unassessed baseline states."""
    out = df.copy()
    flag_col = get_best_col(out, ["ANOMALY_FLAG", "SEVERITY"], default_index=None)
    bool_col = get_best_col(out, ["IS_ANOMALY"], default_index=None)
    flags = out[flag_col].astype(str).str.strip().str.upper() if flag_col else pd.Series("", index=out.index)
    events = flags.isin(["SPIKE", "DROP", "ANOMALY", "TRUE", "1", "1.0"])
    assessed = flags.isin(["NORMAL", "FALSE", "0", "0.0"]) | events
    if not flag_col and bool_col:
        flags = out[bool_col].astype(str).str.strip().str.upper()
        events = flags.isin(["TRUE", "1", "1.0"])
        assessed = events | flags.isin(["FALSE", "0", "0.0"])
    if "BASELINE_STATUS" in out:
        unavailable = out["BASELINE_STATUS"].astype(str).str.upper().str.contains(
            "INSUFFICIENT|INCOMPLETE|MISSING|ZERO_VARIANCE|UNAVAILABLE", regex=True, na=False)
        events &= ~unavailable
        assessed &= ~unavailable
    rows = out.loc[events].copy()
    if "Z_SCORE" in rows:
        rows = rows.sort_values("Z_SCORE", key=lambda column: pd.to_numeric(column, errors="coerce").abs(), ascending=False)
    excess = None
    if rows.empty:
        excess = 0.0 if bool(assessed.any()) else None
    elif "EXCESS_CREDITS" in rows:
        amounts = pd.to_numeric(rows["EXCESS_CREDITS"], errors="coerce")
        if amounts.notna().all() and ~amounts.isin([float("inf"), -float("inf")]).any():
            excess = float(amounts.clip(lower=0).sum())
    elif {"DAILY_CREDITS", "AVG_14D"}.issubset(rows.columns):
        actual = pd.to_numeric(rows["DAILY_CREDITS"], errors="coerce")
        baseline = pd.to_numeric(rows["AVG_14D"], errors="coerce")
        finite = ~actual.isin([float("inf"), -float("inf")]).any() and ~baseline.isin([float("inf"), -float("inf")]).any()
        if actual.notna().all() and baseline.notna().all() and actual.ge(0).all() and baseline.ge(0).all() and finite:
            candidate = (actual - baseline).clip(lower=0)
            if not candidate.isin([float("inf"), -float("inf")]).any():
                excess = float(candidate.sum())
    return {"events": rows, "assessed": int(assessed.sum()),
            "unassessed": int((~assessed).sum()), "excess": excess}


def _overview_idle(df, month, cutoff):
    dated, meta = _overview_source(df, ["IDLE_CREDITS"])
    period = _overview_month(dated, month, cutoff)
    required = {"WAREHOUSE_NAME", "COMPUTE_CREDITS", "IDLE_CREDITS"}
    if period.empty or not required.issubset(period.columns):
        return {"total": None, "rank": pd.DataFrame(), "days": 0, "invalid": len(period)}
    compute = pd.to_numeric(period["COMPUTE_CREDITS"], errors="coerce")
    eligible = period["_valid"] & compute.notna() & compute.ge(period["_credits"])
    eligible &= ~compute.isin([float("inf"), -float("inf")]) & period["WAREHOUSE_NAME"].notna()
    good = period.loc[eligible].copy()
    good["_compute"] = compute.loc[eligible]
    rank = good.groupby("WAREHOUSE_NAME", as_index=False).agg(
        IDLE_CREDITS=("_credits", "sum"), COMPUTE_CREDITS=("_compute", "sum"))
    rank["IDLE_PCT"] = rank["IDLE_CREDITS"].div(rank["COMPUTE_CREDITS"].where(rank["COMPUTE_CREDITS"].gt(0))).mul(100)
    rank = rank.sort_values("IDLE_CREDITS", ascending=False)
    invalid = int((~eligible).sum()) + int(dated["_day"].isna().sum())
    return {"total": float(good["_credits"].sum()) if not good.empty and not invalid else None,
            "rank": rank, "days": good["_day"].nunique(), "invalid": invalid}


