# ---------------------------------------------------------------------------
# Demo catalog — used when Snowflake is not connected (local preview).
# In Snowflake Streamlit, st.connection("snowflake") is used instead.
# Seeded so KPIs, charts, and drill-downs tell one coherent story.
# ---------------------------------------------------------------------------
def _mulberry32(seed):
    a = seed & 0xFFFFFFFF
    def rng():
        nonlocal a
        a = (a + 0x6D2B79F5) & 0xFFFFFFFF
        t = (a ^ (a >> 15)) * (1 | a)
        t &= 0xFFFFFFFF
        t = (t + ((t ^ (t >> 7)) * (61 | t))) & 0xFFFFFFFF
        return ((t ^ (t >> 14)) & 0xFFFFFFFF) / 4294967296
    return rng


def _iso(d):
    return d.strftime("%Y-%m-%d")


@st.cache_data(show_spinner=False)
def build_demo_catalog():
    from datetime import date, timedelta
    rng = _mulberry32(20260909)
    _attribution_version = 6  # per-user CoCo / Cortex attribution

    def jitter(base, spread=0.18):
        return base * (1 + (rng() - 0.5) * 2 * spread)

    as_of = date(2026, 9, 9)
    history_days = 90
    dates = [as_of - timedelta(days=history_days - 1 - i) for i in range(history_days)]
    date_s = [_iso(d) for d in dates]

    warehouses = [
        {"name": "ANALYTICS_WH", "size": "LARGE", "base": 24.0, "weekend": 0.42, "util": 61},
        {"name": "ETL_WH", "size": "MEDIUM", "base": 15.5, "weekend": 0.12, "util": 79},
        {"name": "BI_WH", "size": "SMALL", "base": 9.2, "weekend": 0.50, "util": 52},
        {"name": "DEV_WH", "size": "X-SMALL", "base": 6.4, "weekend": 0.92, "util": 11},
        {"name": "ML_WH", "size": "MEDIUM", "base": 3.8, "weekend": 0.28, "util": 44},
    ]
    users = [
        ("priya.nair", 0.22, "ANALYTICS_WH"),
        ("james.chen", 0.18, "ETL_WH"),
        ("tableau_svc", 0.16, "BI_WH"),
        ("dbt_svc", 0.14, "ETL_WH"),
        ("rahul.p", 0.10, "ANALYTICS_WH"),
        ("sarah.kim", 0.09, "BI_WH"),
        ("fivetran_svc", 0.07, "ETL_WH"),
        ("cortex_app", 0.04, "ML_WH"),
        ("maya.r", 0.00, "ANALYTICS_WH"),
    ]
    # Who actually burned credits on each warehouse (shares renormalized per warehouse).
    # Snowsight analysts were missing from the old home-warehouse split.
    occupancy = [
        ("priya.nair", "ANALYTICS_WH", 0.46, "SNOWSIGHT"),
        ("maya.r", "ANALYTICS_WH", 0.34, "SNOWSIGHT"),
        ("rahul.p", "ANALYTICS_WH", 0.20, "SNOWSIGHT"),
        ("dbt_svc", "ETL_WH", 0.48, "SERVICE_ACCOUNT"),
        ("james.chen", "ETL_WH", 0.30, "SNOWSIGHT"),
        ("fivetran_svc", "ETL_WH", 0.22, "SERVICE_ACCOUNT"),
        ("tableau_svc", "BI_WH", 0.58, "SERVICE_ACCOUNT"),
        ("sarah.kim", "BI_WH", 0.42, "SNOWSIGHT"),
        ("cortex_app", "ML_WH", 0.62, "SERVICE_ACCOUNT"),
        ("priya.nair", "ML_WH", 0.38, "SNOWSIGHT"),
        ("intern.ada", "DEV_WH", 0.55, "SNOWSIGHT"),
        ("james.chen", "DEV_WH", 0.45, "SNOWSIGHT"),
    ]
    services = [
        "WAREHOUSE_METERING", "CLOUD_SERVICES", "PIPE", "AUTO_CLUSTERING",
        "MATERIALIZED_VIEW", "SEARCH_OPTIMIZATION", "SNOWPARK_CONTAINER_SERVICES",
        "AI_SERVICES", "AI_FUNCTIONS", "CORTEX_SEARCH",
        "CORTEX_CODE_SNOWSIGHT", "CORTEX_AGENTS", "QUERY_ACCELERATION",
    ]

    def is_weekend(d):
        return d.weekday() >= 5

    def wh_credits(name, d, i):
        spec = next(w for w in warehouses if w["name"] == name)
        v = jitter(spec["base"], 0.16)
        if is_weekend(d):
            v *= spec["weekend"]
        if name == "ML_WH":
            v *= 1 + i * 0.0045
        if name == "ANALYTICS_WH" and _iso(d) == "2026-09-04":
            v *= 2.55
        if name == "ETL_WH" and _iso(d) == "2026-08-28":
            v *= 1.80
        if name == "DEV_WH":
            v = jitter(spec["base"], 0.06)
        return max(0.2, round(v, 2))

    wh_daily = []
    for i, d in enumerate(dates):
        for w in warehouses:
            credits = wh_credits(w["name"], d, i)
            cloud = round(credits * 0.07, 2)
            wh_daily.append({
                "WAREHOUSE_NAME": w["name"], "USAGE_DATE": _iso(d),
                "CREDITS_USED": credits, "CREDITS_COMPUTE": round(credits - cloud, 2),
                "CREDITS_CLOUD": cloud,
            })
    df_wh = pd.DataFrame(wh_daily)

    util_rows = []
    for r in wh_daily:
        spec = next(w for w in warehouses if w["name"] == r["WAREHOUSE_NAME"])
        util = jitter(spec["util"], 0.12)
        if r["WAREHOUSE_NAME"] == "DEV_WH":
            util = jitter(11, 0.2)
        d = date.fromisoformat(r["USAGE_DATE"])
        if is_weekend(d) and r["WAREHOUSE_NAME"] != "DEV_WH":
            util *= 0.55
        util = min(96, max(6, util))
        active = round((util / 100) * 24)
        util_rows.append({
            "WAREHOUSE_NAME": r["WAREHOUSE_NAME"], "USAGE_DATE": r["USAGE_DATE"],
            "ACTIVE_HOURS": active, "IDLE_HOURS": 24 - active,
            "UTILIZATION_PCT": round(util, 1), "DAILY_CREDITS": r["CREDITS_USED"],
        })
    df_util = pd.DataFrame(util_rows)

    mom_rows = []
    for w in warehouses:
        prev = 0.0
        for month in ("2026-07", "2026-08", "2026-09"):
            credits = df_wh[(df_wh["WAREHOUSE_NAME"] == w["name"]) & df_wh["USAGE_DATE"].str.startswith(month)]["CREDITS_USED"].sum()
            mom_rows.append({
                "WAREHOUSE_NAME": w["name"], "MONTH": month + "-01",
                "CREDITS": round(credits, 2), "PREV_MONTH_CREDITS": round(prev, 2),
                "CHANGE": round(credits - prev, 2),
            })
            prev = credits
    df_mom = pd.DataFrame(mom_rows)

    svc_rows = []
    by_date = df_wh.groupby("USAGE_DATE")["CREDITS_USED"].sum().to_dict()
    for d in date_s:
        wh = by_date.get(d, 0)
        extras = {
            "WAREHOUSE_METERING": wh,
            "CLOUD_SERVICES": jitter(wh * 0.08, 0.1),
            "PIPE": jitter(0.6 if date.fromisoformat(d).weekday() >= 5 else 2.1, 0.25),
            "AUTO_CLUSTERING": jitter(1.1, 0.3),
            "MATERIALIZED_VIEW": jitter(0.45, 0.2),
            "SEARCH_OPTIMIZATION": jitter(0.22, 0.15),
            "SNOWPARK_CONTAINER_SERVICES": jitter(4.8, 0.08),
            "AI_SERVICES": jitter(1.4 + (0.6 if d >= "2026-08-01" else 0), 0.35),
            "AI_FUNCTIONS": jitter(9.4 if d == "2026-09-07" else 1.8, 0.3),
            "CORTEX_SEARCH": jitter(0.55, 0.4),
            "CORTEX_CODE_SNOWSIGHT": jitter(1.15, 0.25),
            "CORTEX_AGENTS": jitter(0.32, 0.45),
            "QUERY_ACCELERATION": jitter(0.35, 0.4),
        }
        for svc, val in extras.items():
            svc_rows.append({
                "USAGE_DATE": d, "SERVICE_TYPE": svc,
                "CREDITS_USED": round(max(0.01, val), 2),
                "TOTAL_CREDITS": round(max(0.01, val), 2),
            })
    df_svc = pd.DataFrame(svc_rows)

    user_rows = []
    occ_by_wh = {}
    for uname, home, share, client in occupancy:
        occ_by_wh.setdefault(home, []).append((uname, share, client))
    for r in wh_daily:
        occupants = occ_by_wh.get(r["WAREHOUSE_NAME"], [])
        total_share = sum(o[1] for o in occupants) or 1.0
        for uname, share, client in occupants:
            cr = r["CREDITS_USED"] * (share / total_share)
            user_rows.append({
                "USER_NAME": uname, "USAGE_DATE": r["USAGE_DATE"],
                "WAREHOUSE_NAME": r["WAREHOUSE_NAME"],
                "SERVICE_TYPE": "WAREHOUSE_METERING",
                "CLIENT_TYPE": client,
                "COST_CENTER": "USER",
                "TOTAL_CREDITS": round(cr, 4),
                "CREDITS_USED": round(cr, 4),
            })

    # Cloud services: most of this is Snowsight (worksheets, result cache, UI).
    snowsight_names = sorted({u for u, _, _, c in occupancy if c == "SNOWSIGHT"})
    other_names = sorted({u for u, _, _, c in occupancy if c != "SNOWSIGHT"})
    cloud_by_date = df_svc[df_svc["SERVICE_TYPE"] == "CLOUD_SERVICES"].set_index("USAGE_DATE")["CREDITS_USED"].to_dict()
    for d, cloud in cloud_by_date.items():
        snow_share = cloud * 0.78
        other_share = cloud * 0.22
        if snowsight_names:
            each = snow_share / len(snowsight_names)
            for uname in snowsight_names:
                user_rows.append({
                    "USER_NAME": uname, "USAGE_DATE": d, "WAREHOUSE_NAME": None,
                    "SERVICE_TYPE": "SNOWSIGHT", "CLIENT_TYPE": "SNOWSIGHT",
                    "COST_CENTER": "USER",
                    "TOTAL_CREDITS": round(each, 4), "CREDITS_USED": round(each, 4),
                })
        if other_names:
            each = other_share / len(other_names)
            for uname in other_names:
                user_rows.append({
                    "USER_NAME": uname, "USAGE_DATE": d, "WAREHOUSE_NAME": None,
                    "SERVICE_TYPE": "CLOUD_SERVICES", "CLIENT_TYPE": "DRIVER",
                    "COST_CENTER": "USER",
                    "TOTAL_CREDITS": round(each, 4), "CREDITS_USED": round(each, 4),
                })

    # Cortex / AI invoked by people (not a system service).
    ai_owners = [("cortex_app", 0.50, "SERVICE_ACCOUNT"), ("priya.nair", 0.28, "SNOWSIGHT"), ("maya.r", 0.22, "SNOWSIGHT")]
    for _, r in df_svc[df_svc["SERVICE_TYPE"].isin(["AI_SERVICES", "AI_FUNCTIONS", "CORTEX_SEARCH"])].iterrows():
        for uname, share, client in ai_owners:
            cr = r["CREDITS_USED"] * share
            user_rows.append({
                "USER_NAME": uname, "USAGE_DATE": r["USAGE_DATE"], "WAREHOUSE_NAME": "ML_WH",
                "SERVICE_TYPE": r["SERVICE_TYPE"], "CLIENT_TYPE": client,
                "COST_CENTER": "USER",
                "TOTAL_CREDITS": round(cr, 4), "CREDITS_USED": round(cr, 4),
            })

    # Platform-hosted: pipes, clustering, MVs, SOS, SPCS, QAS — SYSTEM expense.
    for _, r in df_svc[df_svc["SERVICE_TYPE"].isin([
        "PIPE", "AUTO_CLUSTERING", "MATERIALIZED_VIEW", "SEARCH_OPTIMIZATION",
        "SNOWPARK_CONTAINER_SERVICES", "QUERY_ACCELERATION",
    ])].iterrows():
        user_rows.append({
            "USER_NAME": "SYSTEM", "USAGE_DATE": r["USAGE_DATE"], "WAREHOUSE_NAME": None,
            "SERVICE_TYPE": r["SERVICE_TYPE"], "CLIENT_TYPE": "SYSTEM",
            "COST_CENTER": "SYSTEM",
            "TOTAL_CREDITS": round(r["CREDITS_USED"], 4),
            "CREDITS_USED": round(r["CREDITS_USED"], 4),
        })
    # Close the gap vs Overview: any metering not on a person (idle WH, leftover AI)
    # becomes SYSTEM so People + SYSTEM = VW_COST_BY_SERVICE for the same days.
    svc_by_day = df_svc.groupby("USAGE_DATE")["CREDITS_USED"].sum()
    usr_by_day = {}
    for row in user_rows:
        usr_by_day[row["USAGE_DATE"]] = usr_by_day.get(row["USAGE_DATE"], 0.0) + row["CREDITS_USED"]
    for d, metered in svc_by_day.items():
        gap = round(float(metered) - float(usr_by_day.get(d, 0.0)), 4)
        if gap > 0.01:
            user_rows.append({
                "USER_NAME": "SYSTEM", "USAGE_DATE": d, "WAREHOUSE_NAME": None,
                "SERVICE_TYPE": "UNATTRIBUTED", "CLIENT_TYPE": "SYSTEM",
                "COST_CENTER": "SYSTEM",
                "TOTAL_CREDITS": gap, "CREDITS_USED": gap,
            })
    df_users = pd.DataFrame(user_rows)

    top_resources = df_wh.groupby("WAREHOUSE_NAME", as_index=False)["CREDITS_USED"].sum()
    top_resources = top_resources.rename(columns={"CREDITS_USED": "TOTAL_CREDITS"})
    top_resources["RESOURCE_NAME"] = top_resources["WAREHOUSE_NAME"]

    # Waste / efficiency — DEV_WH is the problem child
    waste = []
    for w in warehouses:
        if w["name"] == "DEV_WH":
            row = dict(WAREHOUSE_NAME=w["name"], UTILIZATION_PCT=11.2, CACHE_MISS_PCT=48.0,
                       FULL_SCAN_PCT=22.0, SPILL_PCT=1.2, QUEUE_PCT=2.0, CREDITS_14D=88.4)
        elif w["name"] == "ANALYTICS_WH":
            row = dict(WAREHOUSE_NAME=w["name"], UTILIZATION_PCT=61.0, CACHE_MISS_PCT=18.0,
                       FULL_SCAN_PCT=41.0, SPILL_PCT=6.5, QUEUE_PCT=12.0, CREDITS_14D=340.2)
