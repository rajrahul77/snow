            col1, col2, col3, col4 = st.columns(4)
            with col1:
                kpi(
                    "Window spend",
                    f"{money(total_credits)}",
                    period=span,
                    delta_color="inverse",
                )
            with col2:
                kpi("Warehouses selected", f"{len(selected_wh)}", period="Count of warehouses in the filter, not a credit figure.")
            with col3:
                kpi(
                    "Peak day · one warehouse",
                    f"{money(peak_day_val)}",
                    period="Highest single warehouse-day in the window — one day, not a total.",
                    delta=peak_wh,
                    delta_color="off",
                )
            with col4:
                avg_per_wh = total_credits / len(selected_wh) if selected_wh else 0
                kpi(
                    "Avg / warehouse",
                    f"{money(avg_per_wh)}",
                    period="Window total ÷ warehouses",
                    delta_color="inverse",
                )

            y_title = _rename_spend_axis("Credits")
            wh_chart = apply_drill(scoped, wh_date, [credit_col], wh_grain, group_col=wh_col, drill_key="wh_grain")
