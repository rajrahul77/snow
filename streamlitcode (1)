    target = max(0.0, _overview_number(st.session_state.get(target_key, 0.0)) or 0.0)
    saved_targets[month] = target
    # Retain the existing target key and session-only semantics. No approved
    # budget is inferred; an unset scenario no longer occupies a headline card.

    anomaly_dates = pd.to_datetime(raw_anomalies.get("USAGE_DATE", pd.Series(index=raw_anomalies.index, dtype=str)), errors="coerce", utc=True).dt.normalize()
