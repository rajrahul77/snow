                               help="Loads the original forecast, budget, efficiency, AI, top resources, unused objects and weekly views on demand.")
        if extended:
            extended_views = ["VW_BUDGET_BURNDOWN", "VW_COST_FORECAST", "VW_WASTE_SCORE", "VW_CORTEX_AI_USAGE",
                              "VW_TOP_RESOURCES", "VW_UNUSED_OBJECTS", "VW_WEEKLY_TRENDS"]
