def this_month(df, date_col):
    """Rows in the calendar month of the latest observation — same grain as Overview MTD."""
    if df is None or df.empty or not date_col or date_col not in df.columns:
        return df.iloc[:0].copy() if df is not None else pd.DataFrame()
    dates = pd.to_datetime(df[date_col], errors="coerce", utc=True).dt.normalize()
    if not dates.notna().any():
        return df.iloc[:0].copy()
    latest = dates.max()
    start = pd.Timestamp(year=int(latest.year), month=int(latest.month), day=1, tz="UTC")
    return df[dates.between(start, latest)].copy()


