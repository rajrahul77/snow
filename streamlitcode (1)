# === SPEND / AI / Cortex ===
def render_ai():
    section_header(
        "AI / Cortex",
        "Who used Copilot in Snowsight, who called COMPLETE(), and which models ran. Containers are not AI.",
    )
    choice = _subnav([
        ("people", "By person"),
        ("spend", "Products"),
        ("models", "Models"),
    ], "ai_sub")
    if choice == "people":
        _render_ai_people()
        return
    if choice == "models":
        _render_ai_models()
        return

    df_ai_svc = cortex_only(run_query("VW_CORTEX_AI_USAGE"))
    df_ai_model = run_query("VW_CORTEX_MODEL_USAGE")

    if not df_ai_svc.empty:
        df_ai_svc = clean_dates(df_ai_svc, ["USAGE_DATE"])
        df_ai_svc["AI_PRODUCT"] = df_ai_svc["SERVICE_TYPE"].map(label_ai_service)
        svc_totals = df_ai_svc.groupby("AI_PRODUCT", as_index=False)["CREDITS_USED"].sum().sort_values(
            "CREDITS_USED", ascending=False)

        snowsight_mask = df_ai_svc["SERVICE_TYPE"].astype(str).str.upper().str.contains("SNOWSIGHT|CODE|COCO")
        fn_mask = df_ai_svc["SERVICE_TYPE"].astype(str).str.upper().str.contains("AI_FUNCTION|AISQL|REST_API")
        search_mask = df_ai_svc["SERVICE_TYPE"].astype(str).str.upper().str.contains("SEARCH|AGENT|COWORK|INTELLIGENCE|ANALYST")
        snowsight_cr = safe_num(df_ai_svc.loc[snowsight_mask, "CREDITS_USED"].sum())
        fn_cr = safe_num(df_ai_svc.loc[fn_mask, "CREDITS_USED"].sum())
        search_cr = safe_num(df_ai_svc.loc[search_mask, "CREDITS_USED"].sum())
        total_ai = safe_num(svc_totals["CREDITS_USED"].sum())
        top_name = str(svc_totals.iloc[0]["AI_PRODUCT"]) if len(svc_totals) else "—"
        top_cr = safe_num(svc_totals.iloc[0]["CREDITS_USED"]) if len(svc_totals) else 0

        col_ai1, col_ai2, col_ai3, col_ai4 = st.columns(4)
        with col_ai1:
            kpi("Cortex credits", money(total_ai), period="AI metering only — no warehouses, no SPCS.")
        with col_ai2:
            kpi("Top product", top_name[:28], period="Largest Cortex line this window.", delta=money(top_cr), delta_color="off")
        with col_ai3:
            kpi("Snowsight CoCo", money(snowsight_cr), period="Cortex Code / Copilot in Snowsight & CLI.")
        with col_ai4:
            kpi("Functions + Agents/Search", money(fn_cr + search_cr), period="AI Functions, Agents, Analyst, Intelligence & Search.")

        hint("Each bar is a Cortex product. If Copilot in Snowsight is your main AI cost, it shows as Cortex in Snowsight — not as a warehouse user.")

        col_aa, col_ab = st.columns(2)
        with col_aa:
            st.markdown("#### Credits by Cortex product")
            svc_plot = axis_label(svc_totals, {"AI_PRODUCT": "Cortex product", "CREDITS_USED": "Credits"})
            safe_render_chart("bar", svc_plot, ["Cortex product"], ["Credits"])
        with col_ab:
            st.markdown("#### AI spend over time")
            ai_grain = drill_control("ai_grain", default="Date")
            daily_ai = df_ai_svc.groupby("USAGE_DATE", as_index=False)["CREDITS_USED"].sum()
            daily_ai = apply_drill(daily_ai, "USAGE_DATE", ["CREDITS_USED"], ai_grain, drill_key="ai_grain")
            daily_ai = axis_label(daily_ai, {"USAGE_DATE": ai_grain, "CREDITS_USED": "Credits (daily)"})
            safe_render_chart("area", daily_ai, [ai_grain], ["Credits (daily)"])
    else:
        empty_state("No Cortex metering in this window. Warehouse COMPLETE() calls still show under Compute until AI_FUNCTIONS lands in METERING_DAILY_HISTORY.")
    return


def _render_ai_people():
    hint(
        "CoCo in Snowsight is Copilot / Cortex Code in the UI. "
        "SQL functions are COMPLETE() in worksheets. Analyst and Agents are their own products. "
        "This is the Cortex line on the bill, not warehouse compute."
    )
    df_ai_users = load_ai_user_attribution()
    if df_ai_users.empty:
        empty_state(
            "No per-user Cortex rows yet. On a live account this reads "
            "CORTEX_CODE_SNOWSIGHT_USAGE_HISTORY (Copilot), Analyst, Agents, and AI functions. "
            "Deploy VW_AI_USER_ATTRIBUTION if the app role cannot query ACCOUNT_USAGE directly."
        )
        return

    u_col = get_best_col(df_ai_users, ["USER_NAME", "USER"])
    c_col = get_best_col(df_ai_users, ["CREDITS", "TOKEN_CREDITS", "CREDITS_USED", "TOTAL_CREDITS"])
    s_col = get_best_col(df_ai_users, ["SURFACE", "INTERFACE", "PRODUCT"])
    d_col = get_best_col(df_ai_users, ["USAGE_DATE", "DATE"])
    r_col = get_best_col(df_ai_users, ["REQUESTS", "INVOCATIONS"], default_index=None)
    t_col = get_best_col(df_ai_users, ["TOKENS", "TOTAL_TOKENS"], default_index=None)
    win = global_range_label()
    if d_col:
        scoped = apply_global_range(df_ai_users, d_col)
        if scoped.empty:
            empty_state(f"No Cortex attribution rows for {win}. Pick a wider Date range in the sidebar.")
            return
    else:
        scoped = df_ai_users

    if not (u_col and c_col):
        empty_state("Per-user Cortex rows are missing USER_NAME / CREDITS columns.")
        return

    hint(f"{win}: {window_span(scoped, d_col)}.")
    people_ai = scoped.groupby(u_col, as_index=False)[c_col].sum().sort_values(c_col, ascending=False)
    coco_mask = scoped[s_col].astype(str).str.contains("CoCo|Snowsight|Copilot", case=False, na=False) if s_col else pd.Series(False, index=scoped.index)
    coco = scoped.loc[coco_mask]
    coco_by = coco.groupby(u_col, as_index=False)[c_col].sum().sort_values(c_col, ascending=False) if not coco.empty else pd.DataFrame()
    top_all = people_ai.iloc[0] if not people_ai.empty else None
    top_coco = coco_by.iloc[0] if not coco_by.empty else None

    a1, a2, a3, a4 = st.columns(4)
    with a1:
        kpi("Top Cortex user", str(top_all[u_col])[:22] if top_all is not None else "—",
            period="All Cortex surfaces in selected window.",
            delta=money(top_all[c_col]) if top_all is not None else None, delta_color="off")
    with a2:
        kpi("Top CoCo / Snowsight user", str(top_coco[u_col])[:22] if top_coco is not None else "—",
            period="Copilot and Cortex Code in the UI.",
            delta=money(top_coco[c_col]) if top_coco is not None else None, delta_color="off")
    with a3:
        kpi("Total Cortex credits", money(safe_num(people_ai[c_col].sum()) if not people_ai.empty else 0),
            period=f"All users combined ({win}).")
    with a4:
        kpi("People on Cortex", f"{people_ai[u_col].nunique() if not people_ai.empty else 0}",
            period="Distinct users with AI activity.")

    if s_col:
        mix = scoped.groupby([u_col, s_col], as_index=False)[c_col].sum()
        keep = mix.groupby(u_col)[c_col].sum().nlargest(12).index
        mix = mix[mix[u_col].isin(keep)]
        st.markdown("#### Credits by person and product")
        mix_plot = axis_label(mix, {u_col: "User", c_col: "Credits", s_col: "Surface"})
        safe_render_chart("bar", mix_plot, ["User"], ["Credits"], ["Surface"])
    elif not people_ai.empty:
        safe_render_chart("bar", axis_label(people_ai.head(12), {u_col: "User", c_col: "Credits"}),
                          ["User"], ["Credits"])

    # Full cumulative ("Till Now") summary table across all history
    st.markdown("#### Complete User Spend & Usage History (Till Now — All Time)")
    period_note("Cumulative lifetime usage per user across all Cortex / AI surfaces in ACCOUNT_USAGE.")
    all_df = clean_dates(df_ai_users.copy(), [d_col] if d_col else [])
    lifetime_rows = []
    for usr, grp in all_df.groupby(u_col):
        cr_sum = round(safe_num(grp[c_col].sum()), 4)
        req_sum = int(safe_num(grp[r_col].sum())) if r_col and r_col in grp.columns else len(grp)
        tok_sum = int(safe_num(grp[t_col].sum())) if t_col and t_col in grp.columns else 0
        act_days = int(grp[d_col].nunique()) if d_col and d_col in grp.columns else 1
        first_dt = str(grp[d_col].min()) if d_col and d_col in grp.columns else "—"
        last_dt = str(grp[d_col].max()) if d_col and d_col in grp.columns else "—"
        surfaces = ", ".join(sorted(grp[s_col].dropna().astype(str).unique())) if s_col and s_col in grp.columns else "—"
        lifetime_rows.append({
            "User": usr,
            "Total Credits (Till Now)": cr_sum,
            "Total Requests": req_sum,
            "Total Tokens": tok_sum,
            "Active Days": act_days,
            "First Used": first_dt,
            "Last Used": last_dt,
            "AI Surfaces Used": surfaces,
        })
    if lifetime_rows:
        df_lifetime = pd.DataFrame(lifetime_rows).sort_values(
            ["Total Credits (Till Now)", "Total Requests"], ascending=[False, False]
        ).reset_index(drop=True)
        show_table(df_lifetime)

    if s_col:
        st.markdown("#### Detailed Breakdown by User & AI Surface (Till Now)")
        by_usr_surf = []
        for (usr, surf), grp in all_df.groupby([u_col, s_col]):
            by_usr_surf.append({
                "User": usr,
                "AI Surface": surf,
                "Credits (Till Now)": round(safe_num(grp[c_col].sum()), 4),
                "Requests": int(safe_num(grp[r_col].sum())) if r_col and r_col in grp.columns else len(grp),
                "Tokens": int(safe_num(grp[t_col].sum())) if t_col and t_col in grp.columns else 0,
                "Active Days": int(grp[d_col].nunique()) if d_col and d_col in grp.columns else 1,
                "First Used": str(grp[d_col].min()) if d_col and d_col in grp.columns else "—",
                "Last Used": str(grp[d_col].max()) if d_col and d_col in grp.columns else "—",
            })
        if by_usr_surf:
            df_usr_surf = pd.DataFrame(by_usr_surf).sort_values(
                ["Credits (Till Now)", "Requests"], ascending=[False, False]
            ).reset_index(drop=True)
            show_table(df_usr_surf)

    col_l, col_r = st.columns(2)
    with col_l:
        st.markdown("#### CoCo / Snowsight ranking")
        hint("Send this list when someone asks who is using Copilot.")
        if not coco_by.empty:
            show_table(axis_label(coco_by.head(20), {u_col: "User", c_col: "CoCo credits"}))
        else:
            st.caption("No CoCo / Snowsight rows in this window.")
    with col_r:
        st.markdown("#### All Cortex, by person")
        show_table(axis_label(people_ai.head(20), {u_col: "User", c_col: "Credits"}))

    if d_col and not people_ai.empty:
        st.markdown("#### Trajectory")
        names = people_ai[u_col].head(8).tolist()
        pick = st.multiselect("People to plot", names, default=names[:3], key="ai_user_traj")
        if pick:
            daily = scoped[scoped[u_col].isin(pick)].copy()
            grain = drill_control("ai_user_grain", default="Date")
            y_title = {"Date": "Credits (daily)", "Month": "Credits (month)", "Year": "Credits (year)"}[grain]
            traj = apply_drill(daily, d_col, [c_col], grain, group_col=u_col, drill_key="ai_user_grain")
            traj = axis_label(traj, {d_col: grain, c_col: y_title, u_col: "User"})
            safe_render_chart("line", traj, [grain], [y_title], ["User"])


def _render_ai_models():
    df_ai_model = run_query("VW_CORTEX_MODEL_USAGE")
    df_ai_svc = cortex_only(run_query("VW_CORTEX_AI_USAGE"))
    if not df_ai_model.empty:
        model_totals = df_ai_model.groupby(["FUNCTION_NAME", "MODEL_NAME"], as_index=False).agg({
            "INVOCATIONS": "sum",
            "TOTAL_INPUT_TOKENS": "sum",
            "TOTAL_OUTPUT_TOKENS": "sum",
            "TOTAL_TOKENS": "sum",
            "TOTAL_CREDITS": "sum"
        }).sort_values("TOTAL_CREDITS", ascending=False)

        # Unit economics — the metric a CFO cares about
        model_totals["CREDITS_PER_1K_TOKENS"] = (
            model_totals["TOTAL_CREDITS"] / (model_totals["TOTAL_TOKENS"] / 1000).replace(0, pd.NA)
        ).round(8)
        total_ai_cr = safe_num(model_totals["TOTAL_CREDITS"].sum())
        model_totals["PCT_OF_AI_SPEND"] = (
            model_totals["TOTAL_CREDITS"] / total_ai_cr * 100
        ).round(1) if total_ai_cr > 0 else 0

        top_model = model_totals.iloc[0]

        cm1, cm2, cm3, cm4 = st.columns(4)
        with cm1:
            st.metric("Tokens Processed", f"{safe_num(model_totals['TOTAL_TOKENS'].sum()):,.0f}",
                      delta="Input + output", delta_color="off")
        with cm2:
            st.metric("Total Invocations", f"{safe_num(model_totals['INVOCATIONS'].sum()):,.0f}",
                      delta="Model calls", delta_color="off")
        with cm3:
            st.metric("Costliest Function", str(top_model["FUNCTION_NAME"])[:20],
                      delta=f"{safe_num(top_model['PCT_OF_AI_SPEND']):.1f}% of AI spend",
                      delta_color="inverse")
        with cm4:
            st.metric("Distinct Models Used", f"{model_totals['MODEL_NAME'].nunique()}",
                      delta="In use", delta_color="off")

        st.info(
            f"**Top cost driver:** `{top_model['FUNCTION_NAME']}`"
            + (f" / `{top_model['MODEL_NAME']}`" if str(top_model['MODEL_NAME']) not in ("N/A", "", "None") else "")
            + f" consumed **{safe_num(top_model['TOTAL_CREDITS']):.4f} credits** across "
            f"{int(safe_num(top_model['INVOCATIONS']))} call(s) and "
            f"{safe_num(top_model['TOTAL_TOKENS']):,.0f} tokens "
            f"({safe_num(top_model['PCT_OF_AI_SPEND']):.1f}% of all AI spend)."
        )

        show_table(axis_label(model_totals, {
            "FUNCTION_NAME": "Function", "MODEL_NAME": "Model", "INVOCATIONS": "Invocations",
            "TOTAL_INPUT_TOKENS": "Input Tokens", "TOTAL_OUTPUT_TOKENS": "Output Tokens",
            "TOTAL_TOKENS": "Total Tokens", "TOTAL_CREDITS": "Credits",
            "CREDITS_PER_1K_TOKENS": "Credits / 1K Tokens", "PCT_OF_AI_SPEND": "% of AI Spend",
        }))

        col_m1, col_m2 = st.columns(2)
        with col_m1:
            st.markdown("#### Credits by Model")
            model_plot = axis_label(model_totals, {
                "MODEL_NAME": "Model", "TOTAL_CREDITS": "Credits", "FUNCTION_NAME": "Function"})
            safe_render_chart("bar", model_plot, ["Model"], ["Credits"], ["Function"])
        with col_m2:
            st.markdown("#### Token Volume by Function")
            fn_plot = axis_label(model_totals, {"FUNCTION_NAME": "Function", "TOTAL_TOKENS": "Tokens"})
            safe_render_chart("bar", fn_plot, ["Function"], ["Tokens"])

        st.markdown("#### Guardrail Signals")
        guard_shown = 0
        for _, m in model_totals.iterrows():
            pct = safe_num(m["PCT_OF_AI_SPEND"])
            calls = safe_num(m["INVOCATIONS"])
            if pct > 40 and calls < 10:
                st.warning(
                    f"`{m['FUNCTION_NAME']}` accounts for **{pct:.1f}%** of AI spend on only "
                    f"{int(calls)} call(s) — very high cost per invocation. Consider batching or "
                    "restricting this function to approved workloads."
                )
                guard_shown += 1
        if guard_shown == 0:
            st.success("No single function is dominating AI spend disproportionately.")
    else:
        st.caption("No per-model usage data available yet.")

    # --- Peak Day Deep Dive ---
    st.markdown("---")
    st.markdown("### Peak Day Deep Dive — Where Did Your Credits Go?")
    st.caption("Select a specific day to see exactly which AI services consumed your credits.")

    if not df_ai_svc.empty:
        df_ai_dated = clean_dates(df_ai_svc.copy(), ["USAGE_DATE"])
        available_dates = sorted(df_ai_dated["USAGE_DATE"].dropna().unique(), reverse=True)

        if available_dates:
            daily_by_svc = df_ai_dated.groupby(["USAGE_DATE", "AI_PRODUCT"], as_index=False)["CREDITS_USED"].sum() if "AI_PRODUCT" in df_ai_dated.columns else df_ai_dated.groupby(["USAGE_DATE", "SERVICE_TYPE"], as_index=False)["CREDITS_USED"].sum()
            daily_totals = df_ai_dated.groupby("USAGE_DATE", as_index=False)["CREDITS_USED"].sum().sort_values(
                "CREDITS_USED", ascending=False)
            prod_col = "AI_PRODUCT" if "AI_PRODUCT" in df_ai_dated.columns else "SERVICE_TYPE"
            svc_totals_all = df_ai_dated.groupby(prod_col, as_index=False)["CREDITS_USED"].sum().sort_values(
                "CREDITS_USED", ascending=False)

            # --- KPI Row ---
            total_ai_all = safe_num(svc_totals_all["CREDITS_USED"].sum())
            peak_day_row = daily_totals.iloc[0] if len(daily_totals) > 0 else {}
            peak_day_val = safe_num(peak_day_row.get("CREDITS_USED", 0))
            peak_day_date = peak_day_row.get("USAGE_DATE", "—")
            top_svc_name = svc_totals_all.iloc[0][prod_col] if len(svc_totals_all) > 0 else "—"
            top_svc_cr = safe_num(svc_totals_all.iloc[0]["CREDITS_USED"]) if len(svc_totals_all) > 0 else 0
            avg_daily = safe_num(daily_totals["CREDITS_USED"].mean()) if len(daily_totals) > 0 else 0

            kpi1, kpi2, kpi3, kpi4 = st.columns(4)
            with kpi1:
                st.metric("Total AI Credits", f"{total_ai_all:,.2f}",
                          delta=f"{len(available_dates)} active days", delta_color="off")
            with kpi2:
                st.metric("Peak Day", f"{peak_day_val:,.2f} cr",
                          delta=str(peak_day_date), delta_color="off")
            with kpi3:
                st.metric("Top product", str(top_svc_name)[:28],
                          delta=f"{top_svc_cr:,.2f} cr total", delta_color="off")
            with kpi4:
                st.metric("Avg Daily Burn", f"{avg_daily:,.2f} cr/day",
                          delta="Across all AI services", delta_color="off")

            # --- Share + Heatmap Row (native Streamlit, no Plotly) ---
            col_donut, col_heat = st.columns([1, 2])

            with col_donut:
                st.markdown("#### Share of Cortex spend")
                svc_share = svc_totals_all.copy()
                total_share = safe_num(svc_share["CREDITS_USED"].sum())
                svc_share["PCT_OF_TOTAL"] = (
                    svc_share["CREDITS_USED"] / total_share * 100
                ).round(1) if total_share > 0 else 0
                show_table(axis_label(
                    svc_share[[prod_col, "CREDITS_USED", "PCT_OF_TOTAL"]],
                    {prod_col: "Cortex product", "CREDITS_USED": "Credits", "PCT_OF_TOTAL": "% of Cortex"}
                ), height=340)

            with col_heat:
                st.markdown("#### Spend Intensity - Service x Date")
                heat_data = daily_by_svc.pivot_table(
                    index=prod_col, columns="USAGE_DATE", values="CREDITS_USED", aggfunc="sum"
                ).fillna(0)
                if not heat_data.empty:
                    heat_data = heat_data[sorted(heat_data.columns)]
                    heat_data.index = [str(s).replace("_", " ").title() for s in heat_data.index]
                    st.dataframe(heat_data.round(4), use_container_width=True, height=340)
                else:
                    st.caption("No AI service/date intensity data available.")

            # --- Day Selector ---
            st.markdown("---")
            peak_days_display = [f"{d}  —  {daily_totals[daily_totals['USAGE_DATE']==d]['CREDITS_USED'].sum():,.4f} credits"
                                 for d in daily_totals["USAGE_DATE"].tolist()[:15]]
            selected_idx = st.selectbox(
                "Drill into a specific day (sorted by highest spend):",
                range(len(peak_days_display)),
                format_func=lambda i: peak_days_display[i],
                key="ai_peak_day_select"
            )
            selected_date = daily_totals["USAGE_DATE"].tolist()[selected_idx]

            # Filter to selected day
            day_data = df_ai_dated[df_ai_dated["USAGE_DATE"] == selected_date].copy()
            day_total = safe_num(day_data["CREDITS_USED"].sum())
            day_data["PCT_OF_DAY"] = (day_data["CREDITS_USED"] / day_total * 100).round(1) if day_total > 0 else 0
            day_data = day_data.sort_values("CREDITS_USED", ascending=False)

            st.markdown(f"#### {selected_date} — Total: **{day_total:,.4f} credits**")

            # Native contribution chart
            waterfall_data = day_data.groupby(prod_col, as_index=False).agg(
                {"CREDITS_USED": "sum", "PCT_OF_DAY": "sum"}).sort_values("CREDITS_USED", ascending=False)

            st.markdown("#### Credit contribution by product")
            waterfall_plot = waterfall_data.copy()
            waterfall_plot["SERVICE"] = waterfall_plot[prod_col].astype(str)
            safe_render_chart("bar", waterfall_plot, ["SERVICE"], ["CREDITS_USED"])

            # Insight callout
            if not day_data.empty:
                top_svc = waterfall_data.iloc[0]
                st.info(
                    f"**Top consumer on {selected_date}:** "
                    f"`{top_svc[prod_col]}` "
                    f"used **{safe_num(top_svc['CREDITS_USED']):,.4f} credits** "
                    f"({safe_num(top_svc['PCT_OF_DAY']):.1f}% of that day)."
                )

            # Model-level detail if available
            if not df_ai_model.empty:
                df_model_dated = clean_dates(df_ai_model.copy(), ["USAGE_DATE"])
                model_day = df_model_dated[df_model_dated["USAGE_DATE"] == selected_date].copy()
                if not model_day.empty:
                    st.markdown(f"#### Model-Level Detail for {selected_date}")
                    model_day["MODEL_LABEL"] = model_day["MODEL_NAME"].fillna("—").replace("", "—")
                    model_day_total = safe_num(model_day["TOTAL_CREDITS"].sum())
                    model_day["PCT"] = (model_day["TOTAL_CREDITS"] / model_day_total * 100).round(1) if model_day_total > 0 else 0
                    detail_table = model_day[["FUNCTION_NAME", "MODEL_LABEL", "INVOCATIONS", "TOTAL_TOKENS",
                                              "TOTAL_CREDITS", "PCT"]].sort_values("TOTAL_CREDITS", ascending=False)
                    show_table(axis_label(detail_table, {
                        "FUNCTION_NAME": "Function", "MODEL_LABEL": "Model", "INVOCATIONS": "Invocations",
                        "TOTAL_TOKENS": "Tokens", "TOTAL_CREDITS": "Credits", "PCT": "% of Model Spend",
                    }))
        else:
            st.caption("No dated AI usage available for drill-down.")
    else:
        st.caption("No AI usage data available for peak day analysis.")


