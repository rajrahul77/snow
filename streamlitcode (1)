def _product_chart_spec(summary, target, daily_mode):
    """Small monthly payload; missing dates stay null and comparisons are guarded."""
    days = pd.date_range(summary["start"], summary["cutoff"], freq="D")
    recorded = summary["daily"].reindex(days)
    values = recorded if daily_mode else recorded.cumsum()
    rate = credit_rate() if show_usd() else 1.0
    actual = [{"Date": day.strftime("%Y-%m-%d"), "Spend": float(value) * rate if pd.notna(value) else None,
               "Series": "Actual", "Usage date": day.strftime("%Y-%m-%d")}
              for day, value in values.items()]
    compare = []
    if summary["comparable"]:
        prior = summary["prior"].groupby("_day")["_credits"].sum().sort_index()
        prior = prior if daily_mode else prior.cumsum()
        for day, value in prior.items():
            mapped_day = summary["start"] + pd.Timedelta(days=day.day - 1)
            compare.append({"Date": mapped_day.strftime("%Y-%m-%d"), "Spend": float(value) * rate,
                            "Series": "Previous month, same days", "Usage date": day.strftime("%Y-%m-%d")})
    forecast = []
    if not daily_mode and summary["projection"] is not None:
        for day in pd.date_range(summary["cutoff"], summary["end"], freq="D"):
            value = summary["total"] + summary["pace"] * (day - summary["cutoff"]).days
            forecast.append({"Date": day.strftime("%Y-%m-%d"), "Spend": value * rate,
                             "Series": "7-day pace estimate", "Usage date": day.strftime("%Y-%m-%d")})
    # Daily views stop at the reporting cutoff, so early-month data uses the chart
    # width. Cumulative outlooks include the rest of the month only if projected.
    axis_end = summary["end"] if forecast or target and not daily_mode else summary["cutoff"]
    axis_end = max(axis_end, summary["start"] + pd.Timedelta(days=1))
    encoding = {
        "x": {"field": "Date", "type": "temporal", "title": None,
              "scale": {"domain": [summary["start"].strftime("%Y-%m-%d"), axis_end.strftime("%Y-%m-%d")]},
              "axis": {"format": "%b %d", "tickCount": 5, "grid": False, "labelPadding": 10}},
        "y": {"field": "Spend", "type": "quantitative", "title": "Estimated USD" if show_usd() else "Credits",
              "scale": {"zero": True}, "axis": {"format": "~g", "tickCount": 4, "titlePadding": 10}},
        "color": {"field": "Series", "type": "nominal", "title": None,
                  "scale": {"domain": ["Actual", "Previous month, same days", "7-day pace estimate"],
                            "range": ["#17818c", "#7f8d99", "#17818c"]},
                  "legend": {"orient": "bottom", "labelFontSize": 11, "offset": 14}},
        "tooltip": [{"field": "Usage date", "type": "temporal", "format": "%b %d, %Y"},
                    {"field": "Spend", "title": "Estimated USD" if show_usd() else "Credits", "type": "quantitative", "format": ".6~g"},
                    {"field": "Series", "type": "nominal"}],
    }
    layers = [{"data": {"values": actual},
               "mark": {"type": "bar", "cornerRadiusTopLeft": 2, "cornerRadiusTopRight": 2,
                        "size": 8, "opacity": .88} if daily_mode else {"type": "line", "strokeWidth": 2.5},
               "encoding": encoding}]
    if compare:
        layers.append({"data": {"values": compare}, "mark": {"type": "line", "strokeWidth": 1.5, "strokeDash": [4, 4]},
                       "encoding": encoding})
    if forecast:
        layers.append({"data": {"values": forecast}, "mark": {"type": "line", "strokeWidth": 2, "strokeDash": [6, 4]},
                       "encoding": encoding})
    if target and not daily_mode:
        layers.append({"data": {"values": [{"Target": target * rate}]},
                       "mark": {"type": "rule", "color": "#bd873a", "strokeDash": [3, 3]},
                       "encoding": {"y": {"field": "Target", "type": "quantitative"},
                                    "tooltip": [{"field": "Target", "title": "Planning target", "type": "quantitative", "format": ".6~g"}]}})
    return {"$schema": "https://vega.github.io/schema/vega-lite/v5.json", "height": 286,
            "layer": layers, "config": {"background": "white", "view": {"stroke": None},
            "axis": {"domain": False, "ticks": False, "gridColor": "#edf0f2", "labelColor": "#667585",
                     "titleColor": "#667585", "labelFontSize": 11, "titleFontSize": 11,
                     "labelFont": "sans-serif", "titleFont": "sans-serif"}}}


def _product_spend_chart(summary, target, daily_mode):
    if summary["daily"].empty:
        st.markdown('<div class="product-chart-empty">No spend data for this month.<br><small>Choose an earlier month or check data access.</small></div>', unsafe_allow_html=True)
        return
    if summary["total"] is None:
        st.markdown('<div class="product-chart-empty">Spend data needs review.<br><small>Check source quality below.</small></div>', unsafe_allow_html=True)
        return
    spec = _product_chart_spec(summary, target, daily_mode)
    try:
        st.vega_lite_chart(spec, width="stretch", theme=None)
    except TypeError:
        st.vega_lite_chart(spec, use_container_width=True, theme=None)


def _product_set_month(month):
    st.session_state["overview_month"] = month


def render_overview():
