def explain_sizing(rec):
    """Human meaning of VW_WAREHOUSE_SIZING.RECOMMENDATION."""
    s = str(rec or "").strip()
    u = s.upper()
    if u.startswith("OK"):
        return (
            "Keep this size",
            "Queries are not waiting in queue, not spilling to remote disk, and there is enough work that shrinking would slow people down.",
        )
    if "UPSIZE + MULTI-CLUSTER" in u:
        return (
            "Scale up + scale out",
            "Both remote spilling and >10% concurrency queueing were detected. Increase warehouse size for memory and add multi-cluster scaling for concurrency.",
        )
    if "SCALE OUT" in u or ("MULTI-CLUSTER" in u and "SPILL" not in u):
        return (
            "Scale out (Multi-Cluster)",
            "More than 10% of queries waited in queue, with no remote spilling. Add multi-cluster scaling rather than upsizing warehouse tier.",
        )
    if "DOWNSIZE" in u or "LIGHT" in u or "AUTO-SUSPEND" in u:
        return (
            "Downsize or lower auto-suspend",
            "Average query is fast and volume is low (<100 queries in 14 days). A smaller warehouse or shorter auto-suspend will cut idle burn.",
        )
    if "SPILL" in u:
        return (
            "Upsize (Scale Up)",
            "Queries ran out of warehouse memory and spilled to remote storage. Increase warehouse tier (do not just add clusters) or optimize heavy joins.",
        )
    if "QUEUE" in u:
        return (
            "Waiting in queue",
            "More than 10% of queries waited for a warehouse slot. Add a cluster, or go one size up.",
        )
    if "UPSIZE" in u:
        return ("Size up", s)
    return (s or "—", "Rule: queue > 10% → scale out; remote spill → scale up; light load → downsize/reduce auto-suspend; else OK.")



