def _overview_spend_chart(summary, target, daily_mode=False):
    days = pd.date_range(summary["start"], summary["cutoff"], freq="D")
    recorded = summary["daily"].reindex(days)
    values = recorded if daily_mode else recorded.cumsum()
    rate = credit_rate() if show_usd() else 1.0
    observed = [{"Date": day.strftime("%Y-%m-%d"), "Spend": float(value) * rate if pd.notna(value) else None,
                 "Series": "Recorded spend"} for day, value in values.items()]
    forecast = []
    if not daily_mode and summary["projection"] is not None:
        for day in pd.date_range(summary["cutoff"], summary["end"], freq="D"):
            value = summary["total"] + summary["pace"] * (day - summary["cutoff"]).days
            forecast.append({"Date": day.strftime("%Y-%m-%d"), "Spend": value * rate,
                             "Series": "7-day pace estimate"})
    if not observed or summary["daily"].empty:
        empty_state("No valid spending records for this month. Choose another reporting month or review source access.")
        return
    encoding = {"x": {"field": "Date", "type": "temporal", "title": None,
                       "scale": {"domain": [summary["start"].strftime("%Y-%m-%d"), summary["end"].strftime("%Y-%m-%d")]},
                       "axis": {"format": "%b %d", "tickCount": 6, "grid": False}},
                "y": {"field": "Spend", "type": "quantitative", "title": "Estimated USD" if show_usd() else "Credits",
                       "scale": {"zero": True}, "axis": {"format": "~g"}},
                "color": {"field": "Series", "type": "nominal", "title": None,
                          "scale": {"domain": ["Recorded spend", "7-day pace estimate"],
                                    "range": ["#1c7a92", "#91a8b2"]}, "legend": {"orient": "bottom"}},
                "tooltip": [{"field": "Date", "type": "temporal", "format": "%b %d, %Y"},
                            {"field": "Spend", "type": "quantitative", "format": ".6~g"},
                            {"field": "Series", "type": "nominal"}]}
    layers = [{"data": {"values": observed}, "mark": {"type": "bar" if daily_mode else "line", "strokeWidth": 3},
               "encoding": encoding}]
    if forecast:
        layers.append({"data": {"values": forecast}, "mark": {"type": "line", "strokeDash": [6, 4], "strokeWidth": 2},
