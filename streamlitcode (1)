def _query_native(sql):
    if is_demo():
        return pd.DataFrame()
    label = "Native AI " + hashlib.sha256(sql.encode()).hexdigest()[:10]
    started = time.perf_counter()
    def load():
        fetched = time.perf_counter()
        df = get_snowflake_conn().query(sql, ttl=0)
        return {"data": normalize_frame(df) if df is not None else pd.DataFrame(),
                "fetched": datetime.now(timezone.utc).isoformat(),
                "seconds": round(time.perf_counter() - fetched, 3)}
    try:
