def render_overview():
    """Executive landing page: material position, trajectory, drivers and decisions only."""
    raw_service = run_query("VW_COST_BY_SERVICE", optional=True, ranged=False)
    raw_anomalies = run_query("VW_COST_ANOMALIES", optional=True)
    service, source_meta = _overview_source(raw_service, ["TOTAL_CREDITS", "CREDITS_USED", "CREDITS"])
    today = pd.Timestamp(datetime.now(timezone.utc)).normalize()
    observed_months = sorted(set(service["_day"].dropna().dt.strftime("%Y-%m"))) if not service.empty else []
    observed_months = [value for value in observed_months if value <= today.strftime("%Y-%m")]
    default_month = observed_months[-1] if is_demo() and observed_months else today.strftime("%Y-%m")
    months = sorted(set(observed_months + [today.strftime("%Y-%m")]), reverse=True)
    if st.session_state.get("overview_month") not in months:
        st.session_state["overview_month"] = default_month

    heading, period = st.columns([3, 1])
    with heading:
        st.markdown('<h1 class="product-page-title">Executive overview</h1>', unsafe_allow_html=True)
    with period:
        month = st.selectbox(
            "Reporting month", months, key="overview_month", label_visibility="collapsed",
            format_func=lambda value: pd.Timestamp(f"{value}-01").strftime("%B %Y"),
        )

    summary = _overview_summary(service, month, today)
    latest_label = summary["latest"].strftime("%d %b %Y") if summary["latest"] is not None else "No observations"
    unit_label = "Estimated USD" if show_usd() else "Metered credits"
    st.caption(f"{unit_label} · data through {latest_label}")

    anomaly_dates = pd.to_datetime(
        raw_anomalies.get("USAGE_DATE", pd.Series(index=raw_anomalies.index, dtype=str)),
        errors="coerce", utc=True,
    ).dt.normalize()
    anomaly_period = raw_anomalies.loc[
        anomaly_dates.dt.strftime("%Y-%m").eq(month) & anomaly_dates.le(summary["cutoff"])
    ].copy()
    scan = _overview_anomaly_scan(anomaly_period)
    service_col = get_best_col(summary["valid"], ["SERVICE_TYPE", "SERVICE"], default_index=None)
    services = _overview_rank(summary["valid"], service_col)
    if summary["total"] is None:
        services = services.iloc[:0]

    amount = lambda value: _overview_amount(value) if _overview_number(value) is not None else "—"
    spend_note = f"{summary['days']} of {summary['expected']} calendar days recorded"
    change_value = f"{summary['delta']:+.1f}%" if summary["delta"] is not None else "—"
    change_note = "Versus the same calendar days last month" if summary["delta"] is not None else "Comparable baseline unavailable"
    estimate_value = amount(summary["projection"]) if summary["current"] else "Closed month"
    estimate_note = "Last seven complete days' pace" if summary["projection"] is not None else summary["forecast_note"]
    exposure_value = amount(scan["excess"]) if scan["assessed"] and scan["excess"] is not None else "—"
    exposure_note = (
        f"{len(scan['events'])} flagged warehouse-day event{'s' if len(scan['events']) != 1 else ''}"
        if scan["assessed"] else "Outlier baseline unavailable"
    )
    metrics = [
        _product_metric("Spend to date", amount(summary["total"]), spend_note,
                        "Observed metered credits in the selected month through the source cutoff."),
        _product_metric("Period change", change_value, change_note,
                        "Equal calendar-day prefixes only; suppressed when either period is incomplete."),
        _product_metric("Month-end estimate", estimate_value, estimate_note,
                        "Unchanged-activity pace scenario, not a statistical forecast."),
        _product_metric("Outlier exposure", exposure_value, exposure_note,
                        "Positive consumption above the source baseline on assessed flagged days; not confirmed savings."),
    ]
    st.markdown('<section class="product-metrics" aria-label="Executive cost scorecard">' + ''.join(metrics) + '</section>', unsafe_allow_html=True)

    issues = []
    if DATA_LOADS.get("VW_COST_BY_SERVICE", {}).get("Status") == "Failed":
        issues.append("Spend source unavailable")
    elif summary["total"] is None:
        issues.append("Spend data unavailable")
    elif not summary["complete"]:
        issues.append(f"Coverage is partial ({summary['days']}/{summary['expected']} days)")
    if summary["latest"] is not None and summary["current"] and (today - summary["latest"]).days > 3:
        issues.append("Usage data is more than three days behind")
    if source_meta["invalid"] or summary["duplicates"]:
        issues.append("Source records require reconciliation")
    if issues:
        st.markdown('<div class="product-notice" role="status"><strong>Decision caution:</strong> ' +
                    html.escape(". ".join(issues) + ".") + '</div>', unsafe_allow_html=True)

    trend_panel, driver_panel = st.columns([2.15, 1], gap="medium")
    with trend_panel:
        with st.container(border=True, key="product_trend_panel"):
            st.markdown('<h2 class="product-panel-title">Spend trajectory</h2>', unsafe_allow_html=True)
            _product_spend_chart(summary, 0.0, daily_mode=False)
            if summary["comparable"]:
                st.caption("Current and prior month are aligned by calendar day.")
            elif summary["projection"] is not None:
                st.caption("Dashed line assumes the latest seven-day pace continues.")
            else:
                st.caption("Trend shown from recorded observations; missing dates are not filled with zero.")
    with driver_panel:
        with st.container(border=True, key="product_driver_panel"):
            st.markdown('<h2 class="product-panel-title">Primary cost drivers</h2>', unsafe_allow_html=True)
            _product_driver_list(services, "Services")
            st.button("Open cost drivers", key="executive_cost_drivers", on_click=_overview_go,
                      args=("platform", "platform_sub", "Serverless"), use_container_width=True)

    decisions = []
    if issues:
        decisions.append(("Data confidence", "Resolve the reporting limitation before using this view for financial decisions.",
                          "people", "people_sub", "Chargeback", "Review coverage"))
    if summary["delta"] is not None and summary["delta"] > 10:
        driver = str(services.iloc[0]["Driver"]).replace("_", " ").title() if not services.empty else "the leading service"
        decisions.append(("Spend acceleration", f"Spend is {summary['delta']:.1f}% above the comparable period; {driver} is the largest current driver.",
                          "plan", "plan_sub", "Velocity", "Investigate"))
    if not scan["events"].empty:
        resource = str(scan["events"].iloc[0].get("WAREHOUSE_NAME", "the leading warehouse"))
        decisions.append(("Cost outliers", f"Review {resource} first; {len(scan['events'])} assessed event(s) are flagged this month.",
                          "plan", "plan_sub", "Anomalies", "Review outliers"))
    raw_guard = run_query("VW_GOVERNANCE_GUARDRAILS", optional=True)
    if not raw_guard.empty and "ACTION_RECOMMENDATION" in raw_guard.columns:
        warn_g = raw_guard[raw_guard["ACTION_RECOMMENDATION"].astype(str).str.upper().str.startswith("DO")]
        if not warn_g.empty:
            g_row = warn_g.iloc[0]
            decisions.append(("Governance guardrails", f"{g_row.get('NAME', 'Guardrail')}: {g_row.get('ACTION_RECOMMENDATION', '')}",
                              "plan", "plan_sub", "Budget", "Review guardrails"))

    st.markdown('<h2 class="product-panel-title product-attention-title">Decisions requiring attention</h2>', unsafe_allow_html=True)
    with st.container(border=True, key="product_attention_panel"):
        if not decisions:
            st.caption("No material decision trigger is supported by the assessed data for this period.")
        for index, (name, note, page, key, section, label) in enumerate(decisions[:3]):
            content, action = st.columns([5, 1.2])
            with content:
                st.markdown(f'<div class="product-action-title">{html.escape(name)}</div><div class="product-action-note">{html.escape(note)}</div>', unsafe_allow_html=True)
            with action:
                st.button(label, key=f"executive_action_{index}", on_click=_overview_go,
