        mom_show = df_mom.sort_values(sort_c, ascending=False) if sort_c else df_mom
        mom_show = axis_label(mom_show, {
            "WAREHOUSE_NAME": "Warehouse", "MONTH": "Month",
            "CREDITS": "Credits (that month)", "PREV_MONTH_CREDITS": "Credits (prior month)",
