def show_table(df, height=360):
    """Page loaded investigations without serializing thousands of rows to the browser."""
    global _TABLE_COUNTER
    if df is None or df.empty:
        empty_state("No rows returned for this section.")
        return
    _TABLE_COUNTER += 1
    route = st.session_state.get("nav_page", "overview")
    # Column signature keeps unrelated tables from sharing pagination state.
    signature = hashlib.sha256(repr(tuple(df.columns)).encode()).hexdigest()[:8]
    key = f"table_{route}_{_TABLE_COUNTER}_{signature}"
    page_size = 25
    pages = max(1, (len(df) + page_size - 1) // page_size)
    page = 1
    if pages > 1:
        stored = st.session_state.get(key, 1)
        if not isinstance(stored, int) or stored < 1 or stored > pages:
            st.session_state[key] = 1
        page = int(st.number_input("Table page", min_value=1, max_value=pages, value=1,
                                   step=1, key=key))
    start = (page - 1) * page_size
    shown = df.iloc[start:start + page_size]
    kwargs = {"hide_index": True}
    if height:
        kwargs["height"] = min(height, 38 + len(shown) * 35)
    try:
        st.dataframe(shown, width="stretch", **kwargs)
    except TypeError:
        st.dataframe(shown, use_container_width=True, **kwargs)
    if pages > 1:
        st.caption(f"Rows {start + 1:,}–{min(start + page_size, len(df)):,} of {len(df):,} loaded rows · "
                   f"page {page} of {pages}")
        if st.checkbox("Prepare CSV for all loaded rows", key=key + "_export", value=False):
            st.download_button("Download loaded rows", df.to_csv(index=False).encode("utf-8"),
                               file_name=f"finops_{route}.csv", mime="text/csv", key=key + "_download")


