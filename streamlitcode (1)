def render_users():
    section_header(
        "Who ran the queries",
        "This is query-attributed compute — credits Snowflake can put on a person or service account. It is not the invoice.",
    )

    df_users = run_query("VW_USER_COSTS")
    df_wh = run_query("VW_WAREHOUSE_DAILY")
    if df_users.empty:
        empty_state("No user costing rows in VW_USER_COSTS.")
        return

    u_col = get_best_col(df_users, ["USER_NAME", "USER"])
    c_col = get_best_col(df_users, ["TOTAL_CREDITS", "COMPUTE_CREDITS", "CREDITS_USED", "CREDITS"])
    u_date = get_best_col(df_users, ["USAGE_DATE", "DATE"])
    if not (u_col and c_col):
        empty_state("User costing columns were not available.")
        return

    # Live VW_USER_COSTS is QUERY_ATTRIBUTION_HISTORY — people only. Drop SYSTEM names.
    names = df_users[u_col].astype(str).str.upper()
    df_users = df_users.loc[~names.isin(SYSTEM_USER_NAMES) & ~names.str.startswith("SYSTEM")].copy()
    df_users = tag_cost_center(df_users)
    df_users = usage_source_label(df_users)
    if "COST_CENTER" in df_users.columns:
        df_users = df_users[df_users["COST_CENTER"].eq("USER")]

    lookback = int(st.session_state.get("lookback_days", 30))
    window_opts = ["All time (till now)", "This month", "Last 7 days", f"Last {lookback} days"]
    win = st.selectbox(
        "Time range",
        window_opts,
        index=0,
        key="people_spend_window",
        help="All time shows full history in VW_USER_COSTS; This month matches Overview.",
    )
    if u_date:
        if win == "All time (till now)":
            df_users = df_users.copy()
        elif win == "This month":
            df_users = this_month(df_users, u_date)
        elif win == "Last 7 days":
            df_users = last_days(df_users, u_date, 7)
        else:
            df_users = last_days(df_users, u_date, lookback)

    wh_total = 0.0
    wh_date = get_best_col(df_wh, ["USAGE_DATE", "DATE"], default_index=None) if not df_wh.empty else None
    wh_cred = get_best_col(df_wh, ["CREDITS_USED", "TOTAL_CREDITS", "CREDITS"], default_index=None) if not df_wh.empty else None
    df_wh_win = df_wh
    if not df_wh.empty and wh_date:
        if win == "All time (till now)":
            df_wh_win = df_wh.copy()
        elif win == "This month":
            df_wh_win = this_month(df_wh, wh_date)
        elif win == "Last 7 days":
            df_wh_win = last_days(df_wh, wh_date, 7)
        else:
            df_wh_win = last_days(df_wh, wh_date, lookback)
        if wh_cred:
            wh_total = safe_num(df_wh_win[wh_cred].sum())

    hint(
        f"{win}: {window_span(df_users, u_date)}. "
        "A person here is whoever ran the SQL. Idle warehouse time, pipes, clustering, storage, and containers are not on this page — they are Compute / Platform."
    )

    people_total = safe_num(df_users[c_col].sum())
    q_col = get_best_col(df_users, ["QUERY_COUNT"], default_index=None)
    query_total = int(safe_num(df_users[q_col].sum())) if q_col else None
    by_user = df_users.groupby(u_col, as_index=False)[c_col].sum().sort_values(c_col, ascending=False)
    people_names = by_user[u_col].nunique() if not by_user.empty else 0
    top_person = by_user.iloc[0] if not by_user.empty else None
    unattributed = max(0.0, wh_total - people_total)

    col1, col2, col3, col4 = st.columns(4)
    with col1:
        kpi("Attributed to people", money(people_total), period="Query compute Snowflake assigned to a user or service account.")
    with col2:
        kpi("People with spend", f"{people_names}", period="Distinct USER_NAME values in this window.")
    with col3:
        kpi(
            "Top person",
            str(top_person[u_col])[:22] if top_person is not None else "—",
            period="Highest attributed compute this window.",
            delta=money(top_person[c_col]) if top_person is not None else None,
            delta_color="off",
        )
    with col4:
        if wh_total:
            kpi(
                "Not on a person",
                money(unattributed),
                period="Warehouse metering minus attributed queries — mostly idle compute.",
                delta=f"Warehouses {money(wh_total)}",
                delta_color="off",
            )
        elif query_total is not None:
            kpi("Statements", f"{query_total:,}", period="Query count in VW_USER_COSTS.")
        else:
            kpi("Window", win, period="Same grain as the bars below.")

    st.markdown("#### Spend by person")
    hint("Each bar is that identity's warehouse query credits. Service accounts (dbt, Tableau, Fivetran) sit next to people.")
    if not by_user.empty:
        top15 = axis_label(by_user.head(15), {u_col: "User", c_col: "Credits (query-attributed)"})
        safe_render_chart("bar", top15, ["User"], ["Credits (query-attributed)"])

    if "USAGE_SOURCE" in df_users.columns and df_users["USAGE_SOURCE"].nunique() > 1:
        st.markdown("#### What they used")
        hint("Split only when the view has a source (warehouse vs Snowsight vs AI). Live QUERY_ATTRIBUTION is warehouse compute.")
        mix = df_users.groupby([u_col, "USAGE_SOURCE"], as_index=False)[c_col].sum()
        keep = mix.groupby(u_col)[c_col].sum().nlargest(8).index
        mix = mix[mix[u_col].isin(keep)]
        mix_plot = axis_label(mix, {u_col: "User", c_col: "Credits", "USAGE_SOURCE": "Source"})
        safe_render_chart("bar", mix_plot, ["User"], ["Credits"], ["Source"])

    user_list = by_user[u_col].tolist()
    st.markdown("#### Trajectory")
    fu1, fu2 = st.columns([2, 1])
    with fu1:
        default_sel = [u for u in user_list if u in ("priya.nair", "maya.r", "james.chen")][:3] or user_list[:3]
        user_filter = st.multiselect("People to plot", user_list, default=default_sel)
    with fu2:
        usr_grain = drill_control("user_traj_grain", default="Date")
    if user_filter:
        user_daily = df_users[df_users[u_col].isin(user_filter)].copy()
        u_date2 = get_best_col(user_daily, ["USAGE_DATE", "DATE"])
        y_title = {"Date": "Credits (daily)", "Month": "Credits (month)", "Year": "Credits (year)"}[usr_grain]
        traj = apply_drill(user_daily, u_date2, [c_col], usr_grain, group_col=u_col, drill_key="user_traj_grain")
        traj = axis_label(traj, {u_date2: usr_grain, c_col: y_title, u_col: "User"})
        safe_render_chart("line", traj, [usr_grain], [y_title], ["User"])

    if st.checkbox("Investigate individual statements and recurring signatures", key="users_statements", value=False):
        st.markdown("---")
        st.markdown("### Largest individual statements")
        period_note(
            "These are single-query estimates for the current month — not the all-in user totals above. "
            "A Snowsight user can look cheap here and still be expensive in the chart."
        )

        df_topq = run_query("VW_TOP_EXPENSIVE_QUERIES")
        if not df_topq.empty:
            df_topq = clean_dates(df_topq, ["QUERY_DATE"])
            df_topq_sorted = df_topq.sort_values("ESTIMATED_CREDITS", ascending=False)
            worst = df_topq_sorted.iloc[0]

            col_q1, col_q2, col_q3, col_q4 = st.columns(4)
            with col_q1:
                st.metric("Costliest statement", f"{safe_num(worst['ESTIMATED_CREDITS']):.4f} cr")
            with col_q2:
                st.metric("Signed-in user", str(worst.get("USER_NAME", "—"))[:22])
            with col_q3:
                st.metric("Warehouse", str(worst.get("WAREHOUSE_NAME", "—"))[:22])
            with col_q4:
                st.metric("Runtime", f"{safe_num(worst.get('ELAPSED_SECONDS', 0)):,.1f}s")

            display_cols = ["QUERY_DATE", "USER_NAME", "WAREHOUSE_NAME", "WAREHOUSE_SIZE",
                            "ESTIMATED_CREDITS", "ELAPSED_SECONDS", "GB_SCANNED", "QUERY_TYPE", "EXECUTION_STATUS"]
            if user_tier != "VIEWER":
                display_cols.append("QUERY_SNIPPET")
            else:
                st.caption("SQL text redacted for VIEWER tier.")
            avail = [c for c in display_cols if c in df_topq_sorted.columns]
            show_table(axis_label(df_topq_sorted[avail].head(25), {
                "QUERY_DATE": "Date", "USER_NAME": "User", "WAREHOUSE_NAME": "Warehouse",
                "WAREHOUSE_SIZE": "Size", "ESTIMATED_CREDITS": "Credits (this statement)",
                "ELAPSED_SECONDS": "Runtime (s)", "GB_SCANNED": "GB Scanned",
                "QUERY_TYPE": "Type", "EXECUTION_STATUS": "Status", "QUERY_SNIPPET": "SQL",
            }))

        st.markdown("---")
        df_exp = run_query("VW_EXPENSIVE_QUERY_PATTERNS")
        if not df_exp.empty:
            st.markdown("#### Recurring query signatures")
            period_note("Pattern roll-up — use this to find repeats, not to total a person's spend.")
            sort_c = get_best_col(df_exp, ["TOTAL_CREDITS", "CREDITS", "EXECUTION_COUNT"])
            show_table(df_exp.nlargest(20, sort_c) if sort_c else df_exp)


