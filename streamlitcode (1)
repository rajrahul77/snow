def _rename_spend_axis(name):
    if not show_usd():
        return name
    s = str(name)
    s = re.sub(r"credits?", "USD", s, flags=re.I)
    s = re.sub(r"\bcr\b", "USD", s, flags=re.I)
    return s


_SKIP_SCALE = re.compile(r"pct|percent|score|hour|count|quer(y|ies)|gb|mb|token|util|runtime|sec|idle_pct", re.I)
_DO_SCALE = re.compile(r"credit|spend|billed|metered|\busd\b|\bcost\b", re.I)


def _scale_spend_frame(df, y_col):
    """Convert credit Y columns to USD when the viewer asked for dollars."""
    if df is None or df.empty or not show_usd():
        return df
    cols = y_col if isinstance(y_col, list) else [y_col]
    out = df.copy()
    rate = credit_rate()
    rename = {}
    for c in cols:
        if not c or c not in out.columns:
            continue
        if _SKIP_SCALE.search(str(c)):
            continue
        if _DO_SCALE.search(str(c)):
            out[c] = pd.to_numeric(out[c], errors="coerce") * rate
            new = _rename_spend_axis(c)
            if new != c:
                rename[c] = new
    if rename:
        out = out.rename(columns=rename)
    return out


