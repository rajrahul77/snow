        st.session_state[key] = legacy if legacy in opts else default
    return st.selectbox(
        "Group time by", opts, key=key,
        format_func=lambda g: {"Date": "Daily", "Month": "Monthly", "Year": "Yearly"}.get(g, g),
        help="Changes chart aggregation. Daily shows each day; monthly and yearly combine periods.",
    )


def _drill_period_filter(df, date_col, grain, key):
    """Advanced focus is optional. A closed expander does not filter any rows."""
    if df is None or df.empty or date_col not in df.columns or grain not in ("Date", "Month"):
        return df
    parsed = pd.to_datetime(df[date_col].astype(str).str.replace('"', '', regex=False),
                            errors="coerce", utc=True).dt.tz_localize(None)
    if parsed.isna().all():
        return df
    if grain == "Date":
        periods = sorted(parsed.dropna().dt.to_period("M").unique(), reverse=True)
        label, suffix = "Month", "month_filter"
        values = [str(p) for p in periods]
        labels = {str(p): p.strftime("%B %Y") for p in periods}
    else:
        values = [str(int(y)) for y in sorted(parsed.dropna().dt.year.unique(), reverse=True)]
        labels = {v: v for v in values}
        label, suffix = "Year", "year_filter"
    if len(values) <= 1:
        return df
    widget_key = f"{key}_{suffix}"
    # Convert the old abbreviated month labels, and clear stale/out-of-window choices.
    old = st.session_state.get(widget_key)
    if old and old not in values and old != "All":
        try:
            migrated = str(pd.Period(pd.to_datetime(old), freq="M")) if grain == "Date" else str(int(old))
        except (ValueError, TypeError):
            migrated = "All"
        st.session_state[widget_key] = migrated if migrated in values else "All"
    with st.expander("Focus on a period", expanded=False):
        enabled = st.checkbox("Limit this chart to one period", value=False, key=f"{key}_focus_enabled")
        if not enabled:
            st.caption("Optional: inspect one month of daily data, or one year of monthly data.")
            return df
        options = ["All"] + values
        if widget_key not in st.session_state:
            st.session_state[widget_key] = values[0]
        selected = st.selectbox(label, options, key=widget_key,
                                format_func=lambda v: "All periods" if v == "All" else labels[v])
    if selected == "All":
        return df
    mask = (parsed.dt.to_period("M").astype(str) == selected if grain == "Date"
            else parsed.dt.year == int(selected))
    return df.loc[mask].copy()


