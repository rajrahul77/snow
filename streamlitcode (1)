def last_days(df, date_col, days, end=None):
    """Inclusive calendar window of exactly N days, anchored to available data."""
    if df.empty or date_col not in df.columns:
        return df.iloc[:0].copy()
    dates = pd.to_datetime(df[date_col], errors="coerce", utc=True).dt.normalize()
    anchor = dates.max() if end is None else pd.to_datetime(end, utc=True).normalize()
    if pd.isna(anchor):
        return df.iloc[:0].copy()
    return df[dates.between(anchor - pd.Timedelta(days=days - 1), anchor)].copy()


