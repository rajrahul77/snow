def render_waste():
    section_header(
        "Efficiency scorecard",
        "Score warehouses on the trailing 14 days of utilization, cache misses, scans, spills, and queueing.",
        period="Efficiency score and CREDITS_14D are trailing 14 days — not lifetime, not month-to-date",
    )

    df_waste = run_query("VW_WASTE_SCORE")
    if not df_waste.empty:
        s_col = get_best_col(df_waste, ["EFFICIENCY_SCORE", "SCORE"], default_index=None)
        if s_col:
            avg_score = safe_num(df_waste[s_col].mean())
            worst_wh = df_waste.nsmallest(1, s_col).iloc[0]

            col_w1, col_w2, col_w3, col_w4 = st.columns(4)
            with col_w1:
                st.metric("Infrastructure Efficiency", f"{avg_score:,.0f} /100",
                          delta="Healthy" if avg_score >= 80 else ("Needs attention" if avg_score >= 60 else "Critical"),
                          delta_color="normal" if avg_score >= 70 else "inverse")
            with col_w2:
                st.metric("Warehouses Scored", f"{len(df_waste)}",
                          delta="In scope", delta_color="off")
            with col_w3:
                st.metric("Lowest Scorer", str(worst_wh.get("WAREHOUSE_NAME", "-"))[:20],
                          delta=f"{safe_num(worst_wh[s_col]):,.0f} /100", delta_color="inverse")
            with col_w4:
                below = int((pd.to_numeric(df_waste[s_col], errors="coerce") < 60).sum())
                st.metric("Below Target", f"{below}",
                          delta="Remediate first" if below > 0 else "All above 60",
                          delta_color="inverse" if below > 0 else "normal")
            st.progress(min(100, max(0, int(avg_score))) / 100)

        with st.expander("How is the Efficiency Score calculated?", expanded=False):
            st.markdown("""
The score starts at **100** and deducts points for each inefficiency signal detected
over the trailing 14 days. Five factors are measured:

| Factor | What it measures | Why it costs money | How to improve |
|---|---|---|---|
| **Utilization %** | How much of the provisioned compute is actually doing work | Low utilization means you pay for idle capacity | Lower `AUTO_SUSPEND` (60s), consolidate small warehouses, or downsize |
| **Cache Miss %** | Share of queries that could not reuse the warehouse's local disk cache | Every cache miss re-reads from remote storage — slower and more credits | Keep related workloads on the same warehouse; avoid frequent suspend/resume cycles |
| **Full Scan %** | Queries reading every micro-partition instead of pruning | Scanning the whole table burns compute unnecessarily | Add clustering keys on filter columns, or enable Search Optimization for point lookups |
| **Spill %** | Queries spilling intermediate results to local or remote disk | Spilling to remote storage can be 10x slower and multiplies runtime cost | Increase warehouse size for those workloads, or reduce join/sort cardinality |
| **Queue %** | Queries waiting for a slot before executing | Queued time signals under-provisioning; users retry and duplicate load | Enable multi-cluster scaling, or move batch jobs off the interactive warehouse |

**Reading the score**

- **80–100** — Healthy. Compute is well matched to the workload.
- **60–79** — Room for optimization. Usually one dominant factor (often utilization or full scans).
- **Below 60** — Critical. Investigate the lowest-scoring warehouse first; the columns in the
  matrix below show which factor is dragging it down.

**Where to act first:** sort the matrix by `CREDITS_14D` descending, then fix the highest-spend
warehouse with the worst score. Optimizing a warehouse that costs 0.1 credits saves nothing.
            """)

        st.markdown("#### Warehouse Efficiency Matrix")
        sort_col = get_best_col(df_waste, ["CREDITS_14D", "TOTAL_CREDITS", "CREDITS"])
        display_waste = df_waste.sort_values(sort_col, ascending=False) if sort_col else df_waste
        show_table(display_waste)

        st.markdown("#### Factor Comparison Across Warehouses")
        factor_cols = [c for c in ["UTILIZATION_PCT", "CACHE_MISS_PCT", "FULL_SCAN_PCT", "SPILL_PCT", "QUEUE_PCT"]
                       if c in df_waste.columns]
        if factor_cols and "WAREHOUSE_NAME" in df_waste.columns:
            factor_plot = axis_label(df_waste, {
                "WAREHOUSE_NAME": "Warehouse", "UTILIZATION_PCT": "Utilization %",
                "CACHE_MISS_PCT": "Cache Miss %", "FULL_SCAN_PCT": "Full Scan %",
                "SPILL_PCT": "Spill %", "QUEUE_PCT": "Queue %",
            })
            factor_labels = [c for c in ["Utilization %", "Cache Miss %", "Full Scan %", "Spill %", "Queue %"]
                             if c in factor_plot.columns]
            safe_render_chart("bar", factor_plot, ["Warehouse"], factor_labels, multi_y=True)

    st.markdown("---")
    st.markdown("#### User Execution Efficiency")
    df_user_waste = run_query("VW_USER_WASTE_SCORE")
    if not df_user_waste.empty:
        u_sort = get_best_col(df_user_waste, ["EFFICIENCY_SCORE", "SCORE"], default_index=None)
        show_table(df_user_waste.sort_values(u_sort) if u_sort else df_user_waste)
    else:
        st.caption("No user efficiency data available.")


