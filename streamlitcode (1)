                  delta_color="inverse" if n_failed else "normal")
    with ca3:
        st.metric("Full Table Scans", f"{n_scans}",
                  delta="Detected" if n_scans else "None",
                  delta_color="inverse" if n_scans else "normal")
    with ca4:
