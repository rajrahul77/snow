    st.markdown("#### Duplicate Query Signatures")
    if not df_dups.empty:
        d_sort = get_best_col(df_dups, ["TOTAL_CREDITS", "EXECUTION_COUNT", "RUN_COUNT", "CREDITS"])
        dups_show = clean_dates(df_dups).sort_values(d_sort, ascending=False) if d_sort else clean_dates(df_dups)
        show_table(dups_show)
        if d_sort:
            hash_col = get_best_col(df_dups, ["QUERY_PARAMETERIZED_HASH", "QUERY_HASH", "USER_NAME"])
            dup_plot = axis_label(df_dups.nlargest(10, d_sort), {hash_col: "Query Signature", d_sort: "Impact"})
            safe_render_chart("bar", dup_plot, ["Query Signature"], ["Impact"])
    else:
        st.caption("No duplicate query signatures detected.")

    st.markdown("#### Failed Query Executions")
    if not df_failed.empty:
        f_sort = get_best_col(df_failed, ["TOTAL_CREDITS", "CREDITS", "ELAPSED_SECONDS",
                                          "TOTAL_ELAPSED_TIME", "FAILURE_COUNT"])
        show_table(clean_dates(df_failed).sort_values(f_sort, ascending=False) if f_sort else clean_dates(df_failed))
    else:
        st.caption("No high-cost query failures recorded.")

    col_ap3, col_ap4 = st.columns(2)
    with col_ap3:
        st.markdown("#### Full Table Scans")
        if not df_scans_ap.empty:
            s_sort = get_best_col(df_scans_ap, ["SCANNED_GB", "GB_SCANNED", "MB_SCANNED", "PARTITIONS_SCANNED", "DURATION_SEC", "ELAPSED_SECONDS"])
            show_table(
                clean_dates(df_scans_ap).sort_values(s_sort, ascending=False).head(15) if s_sort
                else clean_dates(df_scans_ap).head(15)
            )
        else:
            st.caption("No full table scans detected.")
    with col_ap4:
        st.markdown("#### Disk Spilling")
        if not df_spill_ap.empty:
            sp_sort = get_best_col(df_spill_ap, ["REMOTE_SPILL_GB", "LOCAL_SPILL_GB", "MB_SPILLED_REMOTE", "GB_SPILLED", "MB_SPILLED_LOCAL", "DURATION_SEC", "ELAPSED_SECONDS"])
            show_table(
                clean_dates(df_spill_ap).sort_values(sp_sort, ascending=False).head(15) if sp_sort
                else clean_dates(df_spill_ap).head(15)
            )
        else:
            st.caption("No spilling queries detected.")

    df_prune_adv = run_query("VW_PRUNING_AND_OPTIMA_ADVISOR", optional=True)
    if not df_prune_adv.empty:
        st.markdown("---")
        st.markdown("#### Column Pruning & Snowflake Optima Advisor (DO / DO NOT)")
        period_note("COLUMN_QUERY_PRUNING_HISTORY + TABLE_OPTIMA_FEATURES — warns against manual clustering/SOS where Snowflake Optima is already active.")
        rec_c = get_best_col(df_prune_adv, ["ACTION_RECOMMENDATION"], default_index=None)
        eff_c = get_best_col(df_prune_adv, ["PRUNE_EFFICIENCY_PCT"], default_index=None)
        opt_idx = df_prune_adv.get("OPTIMA_INDEXING_APPLIED", pd.Series(False, index=df_prune_adv.index)).astype(bool)
        opt_cls = df_prune_adv.get("OPTIMA_CLUSTERING_APPLIED", pd.Series(False, index=df_prune_adv.index)).astype(bool)
        optima_active = df_prune_adv[opt_idx | opt_cls]
        do_action = (
            df_prune_adv[df_prune_adv[rec_c].astype(str).str.startswith("DO ")]
            if rec_c else pd.DataFrame()
        )
        avg_eff = safe_num(df_prune_adv[eff_c].mean()) if eff_c else 0.0
        cp1, cp2, cp3, cp4 = st.columns(4)
        with cp1:
            st.metric("Filter Columns Analyzed", f"{len(df_prune_adv)}",
                      delta="Last 30 days", delta_color="off")
        with cp2:
            st.metric("Protected by Optima", f"{len(optima_active)}",
                      delta="DO NOT manually cluster/index" if len(optima_active) > 0 else "No Optima tables",
                      delta_color="normal")
        with cp3:
            st.metric("Columns Needing Action", f"{len(do_action)}",
                      delta="Candidate for SOS / Cluster" if len(do_action) > 0 else "None",
                      delta_color="inverse" if len(do_action) > 0 else "normal")
        with cp4:
            st.metric("Avg Prune Efficiency", f"{avg_eff:.1f}%",
                      delta="Healthy" if avg_eff >= 50 else "Low pruning",
                      delta_color="normal" if avg_eff >= 50 else "inverse")
        if len(optima_active) > 0:
            st.info(
                f"**Snowflake Optima is active on {len(optima_active)} column entry(s):** "
                "DO NOT pay for manual Automatic Clustering or Search Optimization on those tables — Snowflake Optima is already indexing/clustering them automatically."
            )
        if len(do_action) > 0:
            top_col_row = do_action.sort_values("PARTITIONS_SCANNED", ascending=False).iloc[0]
            st.warning(
                f"**Top pruning opportunity:** `{top_col_row.get('DATABASE_NAME', '')}.{top_col_row.get('SCHEMA_NAME', '')}."
                f"{top_col_row.get('TABLE_NAME', '')}.{top_col_row.get('COLUMN_NAME', '')}` — "
                f"{top_col_row.get('ACTION_RECOMMENDATION', '')}"
