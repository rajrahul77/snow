class DashboardSourceError(RuntimeError):
    """Sanitized error; cached failures never become an empty successful source."""
    def __init__(self, error_type, errno=None):
        super().__init__("Dashboard source unavailable")
        self.source_error_type = error_type
        self.errno = errno


def _cache_size(value):
    if isinstance(value, pd.DataFrame):
        return int(value.memory_usage(index=True, deep=True).sum())
    if isinstance(value, dict):
        return sum(_cache_size(v) for v in value.values())
    if isinstance(value, (tuple, list)):
        return sum(_cache_size(v) for v in value)
    return 256


def _session_memo(namespace, key, loader, ttl=QUERY_TTL_SECONDS, refresh_sensitive=True):
    """Bounded browser-session cache, including brief negative caching.

    No shared account/role data cache or worker threads touch a connection.
    Copies keep page-specific filters and currency conversions out of the cache.
    """
    cache = st.session_state.setdefault("_finops_session_cache", {})
    now = time.monotonic()
    generation = st.session_state.get("finops_refresh_generation", 0) if refresh_sensitive else 0
    context = st.session_state.get("_finops_security_fingerprint", ())
    cache_key = (APP_BUILD, SCHEMA, st.session_state.get("_finops_backend"),
                 context, generation, namespace, key)
    for old_key in list(cache):
        if cache[old_key]["expires"] <= now:
            del cache[old_key]
    hit = cache_key in cache and ttl > 0
    if hit:
        entry = cache.pop(cache_key)
        cache[cache_key] = entry  # least-recently-used eviction order
    else:
        try:
            value = loader()
            entry = {"value": value, "error": None,
                     "expires": time.monotonic() + ttl, "bytes": _cache_size(value)}
        except Exception as exc:
            entry = {"value": None, "error": (type(exc).__name__, getattr(exc, "errno", None)),
                     "expires": time.monotonic() + FAILED_QUERY_TTL_SECONDS, "bytes": 256}
        if ttl > 0 and entry["bytes"] <= SESSION_CACHE_MAX_BYTES:
            cache[cache_key] = entry
            while (len(cache) > SESSION_CACHE_MAX_ENTRIES
                   or sum(v["bytes"] for v in cache.values()) > SESSION_CACHE_MAX_BYTES):
                del cache[next(iter(cache))]
    if entry["error"]:
        raise DashboardSourceError(*entry["error"])
    return copy.deepcopy(entry["value"]), hit


def chronological_frame(df):
    """Order dated rows before any page selects the latest observation."""
    for col in DATE_COLUMNS:
        if col in df.columns:
            dates = pd.to_datetime(df[col], errors="coerce", utc=True)
            if dates.notna().any():
                # Invalid dates first: they cannot become the latest observation.
                return df.assign(_sort_date=dates).sort_values(
                    "_sort_date", kind="stable", na_position="first"
                ).drop(columns="_sort_date").reset_index(drop=True)
    return df.reset_index(drop=True)


def normalize_frame(df):
    """Preserve identifiers, missing values and date precision."""
    out = df.copy()
    for col in out.columns:
        series = out[col]
        upper = str(col).upper()
        sample = series.dropna()
        if sample.empty:
            continue
        is_date = (pd.api.types.is_datetime64_any_dtype(series)
                   or upper in DATE_COLUMNS
                   or sample.head(20).map(lambda v: hasattr(v, "strftime")).all())
        if is_date:
            dates = pd.to_datetime(series.astype(str).str.replace('"', '', regex=False),
                                   errors="coerce", utc=True)
            if dates.notna().any():
                has_time = bool((dates.dropna() != dates.dropna().dt.normalize()).any())
                out[col] = dates.dt.strftime("%Y-%m-%d %H:%M:%S" if has_time else "%Y-%m-%d")
            continue
        identifier = upper.endswith(("_ID", "_NAME", "_TYPE", "_STATUS"))
        if not identifier:
            numeric = pd.to_numeric(series, errors="coerce")
            if numeric.notna().sum() == series.notna().sum():
                out[col] = numeric
    return chronological_frame(out)


def _fetch_view(view_name):
    if view_name not in ALLOWED_VIEWS:
        raise ValueError("Unknown dashboard data source")
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*\.[A-Za-z_][A-Za-z0-9_]*", SCHEMA):
        raise ValueError("Invalid dashboard schema")
    def load():
        started = time.perf_counter()
        if is_demo():
            df = build_demo_catalog().get(view_name, pd.DataFrame())
        else:
            df = get_snowflake_conn().query(f"SELECT * FROM {SCHEMA}.{view_name}", ttl=0)
        result = normalize_frame(df) if df is not None else pd.DataFrame()
        latest = "Not provided"
        for col in DATE_COLUMNS:
            if col in result.columns:
                parsed = pd.to_datetime(result[col], errors="coerce", utc=True)
                if parsed.notna().any():
                    latest = parsed.max().isoformat()
                    break
        return {"data": result, "fetched": datetime.now(timezone.utc).isoformat(),
                "latest": latest, "seconds": round(time.perf_counter() - started, 3)}
    return _session_memo("view", view_name, load)



def run_query(view_name, optional=False, ranged=True):
    """Same dataframe API; session cache preserves empty versus failed states.
    Time-series views are filtered to the app-wide date range unless ranged=False."""
    started = time.perf_counter()
    try:
        record, hit = _fetch_view(view_name)
        df = record["data"]
        if ranged and view_name in RANGED_VIEWS:
            df = apply_global_range(df)
        DATA_LOADS[view_name] = {
            "Source": view_name, "Status": "Empty" if df.empty else "Loaded",
            "Rows": len(df), "Fetched at (UTC)": record["fetched"],
            "Latest observation (UTC)": record["latest"],
            "Database fetch seconds": record["seconds"], "Session cache": "Hit" if hit else "Miss",
            "This run seconds": round(time.perf_counter() - started, 3),
        }
        return df
    except Exception as exc:
        code = getattr(exc, "errno", None)
        error_type = getattr(exc, "source_error_type", type(exc).__name__)
        LOGGER.warning("FinOps source %s failed (%s, code=%s)", view_name, error_type, code)
        DATA_LOADS[view_name] = {
            "Source": view_name, "Status": "Failed", "Rows": None,
            "Fetched at (UTC)": "Unavailable", "Latest observation (UTC)": "Unavailable",
            "Error type": error_type, "Error code": str(code or "Unavailable"),
            "This run seconds": round(time.perf_counter() - started, 3),
        }
        if not optional:
            st.warning(f"{view_name}: data could not be loaded. Check availability and access. "
                       "This is not a zero-usage result. Refresh data to retry immediately.")
        return pd.DataFrame()


