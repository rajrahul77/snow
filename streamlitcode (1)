# === RISK / Anomalies ===
def render_anomalies():
    section_header(
        "Cost anomalies",
        "Source-flagged warehouse days. Positive excess is usage above baseline; both spikes and drops deserve investigation.",
        period="One warehouse-day per point · source Z-score uses that warehouse's trailing baseline",
    )
    df_anom = run_query("VW_COST_ANOMALIES")
    if df_anom.empty:
        st.caption("No anomaly data available. This does not establish that spend has no outliers.")
        return
    df_anom = clean_dates(df_anom, ["USAGE_DATE"])
    scan = _overview_anomaly_scan(df_anom)
    true_anom = scan["events"]
    z_col = get_best_col(df_anom, ["Z_SCORE"], default_index=None)
    flag_col = get_best_col(df_anom, ["ANOMALY_FLAG", "SEVERITY", "IS_ANOMALY"], default_index=None)
    wh_col = get_best_col(df_anom, ["WAREHOUSE_NAME", "SERVICE_TYPE"], default_index=None)
    dc_col = get_best_col(df_anom, ["DAILY_CREDITS"], default_index=None)
    df_sorted = df_anom.sort_values(z_col, key=lambda column: pd.to_numeric(column, errors="coerce").abs(), ascending=False) if z_col else df_anom
    deviation = pd.to_numeric(true_anom[z_col], errors="coerce").abs().max() if z_col and not true_anom.empty else None
    cols = st.columns(4)
    with cols[0]:
        kpi("Flagged warehouse-days", str(len(true_anom)) if scan["assessed"] else "Not assessed",
            period="Source flags; insufficient baselines and zero variance are excluded.")
    with cols[1]:
        kpi("Positive excess above baseline", _overview_amount(scan["excess"]),
            period="Sum positive actual-minus-baseline for flagged events. Missing baseline leaves this unavailable.")
    with cols[2]:
        kpi("Peak absolute deviation", f"{deviation:.2f} σ" if _overview_number(deviation) is not None else "Not available",
            period="Magnitude of deviation; negative Z-scores indicate drops.")
    with cols[3]:
        kpi("First warehouse to investigate", str(true_anom.iloc[0][wh_col]) if not true_anom.empty and wh_col else "Not available",
            period="Largest absolute source Z-score among recognized event flags.")
    st.caption(f"{scan['assessed']} assessed warehouse-day records · {scan['unassessed']} unassessed records. "
               "Event counts are historical source detections, not unresolved incident counts.")
    if not true_anom.empty:
        top = true_anom.iloc[0]
        amount = _overview_amount(top.get(dc_col)) if dc_col else "Not available"
        score = _overview_number(top.get(z_col)) if z_col else None
        direction = "above" if score is not None and score >= 0 else "below"
        deviation_copy = f"{abs(score):.2f} standard deviations {direction} its baseline" if score is not None else "baseline deviation unavailable"
        st.warning(f"Highest deviation: {top.get(wh_col, 'Unknown warehouse')} on {top.get('USAGE_DATE', 'unknown date')} · "
                   f"{amount} · {deviation_copy}. Confirm demand and baseline coverage before changing resources.")
        st.markdown("#### Source-flagged events · largest absolute deviation first")
        show_table(true_anom)
    elif scan["assessed"]:
        st.info("No recognized outlier events in the assessed records. Coverage and unavailable baselines still need review.")
    else:
        st.warning("No assessable anomaly classifications are available. No all-clear conclusion can be drawn.")
    st.markdown("#### Deviation distribution")
    mapping = {"USAGE_DATE": "Date", "DAILY_CREDITS": "Daily Credits"}
    if z_col:
        mapping[z_col] = "Deviation (σ)"
    plot = axis_label(df_sorted, mapping)
    if z_col or dc_col:
        safe_render_chart("scatter", plot, ["Date", "USAGE_DATE", "DATE"],
                          ["Deviation (σ)"] if z_col else ["Daily Credits"],
                          [c for c in [flag_col, wh_col] if c])
    with st.expander("Full anomaly scan history · including unassessed days"):
        show_table(df_sorted)


