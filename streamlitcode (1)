# === GOVERN / Actions ===
def render_remediation():
    section_header(
        "Actions",
        "Suspend idle warehouses, or copy the SQL and run it yourself.",
    )

    if user_tier == "VIEWER":
        st.info("Read-only view. State changes require DATA_ENGINEER or FINOPS_ADMIN role.")

    _conn = get_snowflake_conn()

    def pick(row, *names):
        """Reads a value from a SHOW result row regardless of column casing."""
        for n in names:
            for variant in (n, n.lower(), n.upper()):
                if variant in row.index:
                    val = row[variant]
                    if val is not None:
                        return val
        return None

    st.markdown("#### Warehouse Fleet Status")
    df_wh_status = None
    try:
        df_wh_status = _conn.query("SHOW WAREHOUSES", ttl=0)
    except Exception as ex:
        st.error(f"Unable to read warehouse state: {ex}")

    if df_wh_status is not None and not df_wh_status.empty:
        started = 0
        suspended = 0
        long_suspend = []

        for _, wh in df_wh_status.iterrows():
            state = str(pick(wh, "state") or "").upper()
            if state == "STARTED":
                started += 1
            elif state == "SUSPENDED":
                suspended += 1
            asp = pick(wh, "auto_suspend")
            try:
                if asp is not None and float(asp) > 120:
                    long_suspend.append((str(pick(wh, "name")), int(float(asp))))
            except Exception:
                pass

        cs1, cs2, cs3 = st.columns(3)
        with cs1:
            st.metric("Total Warehouses", len(df_wh_status))
        with cs2:
            st.metric("Currently Running", started,
                      delta="Billing now" if started > 0 else "All idle",
                      delta_color="inverse" if started > 0 else "normal")
        with cs3:
            st.metric("Suspended", suspended)

        st.markdown("")
        for _, wh in df_wh_status.iterrows():
            wh_name = str(pick(wh, "name") or "")
            wh_state = str(pick(wh, "state") or "UNKNOWN").upper()
            wh_size = str(pick(wh, "size") or "-")
            wh_asp = pick(wh, "auto_suspend")
            wh_running = pick(wh, "running")
            wh_queued = pick(wh, "queued")

            if not wh_name:
                continue

            badge = "RUNNING" if wh_state == "STARTED" else wh_state
            ca, cb, cc = st.columns([4, 2, 1])
            with ca:
                st.write(f"**{wh_name}** — `{badge}`")
                st.caption(
                    f"Size: {wh_size} | Auto-suspend: {wh_asp}s | "
                    f"Running: {wh_running} | Queued: {wh_queued}"
                )
            with cb:
                if wh_state == "STARTED":
                    st.caption("Consuming credits")
                else:
                    st.caption("No cost while suspended")
            with cc:
                if user_tier == "VIEWER":
                    st.caption("—")
                elif wh_state == "STARTED":
                    if st.button("Suspend", key=f"sus_wh_{wh_name}", type="primary"):
                        try:
                            execute_resource_action("WAREHOUSE", [wh_name], "SUSPEND")
                            st.success(f"Suspended {wh_name}")
                            st.rerun()
                        except Exception as ex:
                            st.error(f"Failed: {ex}")
                else:
                    if st.button("Resume", key=f"res_wh_{wh_name}"):
                        try:
                            execute_resource_action("WAREHOUSE", [wh_name], "RESUME")
                            st.success(f"Resumed {wh_name}")
                            st.rerun()
                        except Exception as ex:
                            st.error(f"Failed: {ex}")
    else:
        st.caption("No warehouses visible to the current role.")

    # -------------------------------------------------------------------------
    # Actionable recommendations derived from the efficiency + sizing views
    # -------------------------------------------------------------------------
    st.markdown("---")
    st.markdown("#### Recommended Actions")

    rec_rows = []

    df_waste_rec = run_query("VW_WASTE_SCORE")
    if not df_waste_rec.empty:
        for _, r in df_waste_rec.iterrows():
            wh = str(r.get("WAREHOUSE_NAME", ""))
            score = safe_num(r.get("EFFICIENCY_SCORE", 100))
            util = safe_num(r.get("UTILIZATION_PCT", 100))
            spill = safe_num(r.get("SPILL_PCT", 0))
            scan = safe_num(r.get("FULL_SCAN_PCT", 0))
            queue = safe_num(r.get("QUEUE_PCT", 0))
            credits = safe_num(r.get("CREDITS_14D", 0))

            if util < 20 and credits > 0:
                rec_rows.append({
                    "TARGET": wh, "SIGNAL": f"Utilization {util:.1f}%",
                    "RECOMMENDATION": "Lower AUTO_SUSPEND to 60s or downsize one tier",
                    "SQL": f"ALTER WAREHOUSE {wh} SET AUTO_SUSPEND = 60;",
                    "CREDITS_14D": credits,
                })
            if spill > 5:
                rec_rows.append({
                    "TARGET": wh, "SIGNAL": f"Spilling {spill:.1f}%",
                    "RECOMMENDATION": "Increase warehouse size to stop remote spilling",
                    "SQL": f"ALTER WAREHOUSE {wh} SET WAREHOUSE_SIZE = 'MEDIUM';",
                    "CREDITS_14D": credits,
                })
            if scan > 50:
                rec_rows.append({
                    "TARGET": wh, "SIGNAL": f"Full scans {scan:.1f}%",
                    "RECOMMENDATION": "Add clustering keys or enable Search Optimization on hot tables",
                    "SQL": "-- Review Query Performance tab for the specific tables",
                    "CREDITS_14D": credits,
                })
            if queue > 10:
                rec_rows.append({
                    "TARGET": wh, "SIGNAL": f"Queueing {queue:.1f}%",
                    "RECOMMENDATION": "Enable multi-cluster scaling to absorb concurrency",
                    "SQL": f"ALTER WAREHOUSE {wh} SET MAX_CLUSTER_COUNT = 3;",
                    "CREDITS_14D": credits,
                })

    df_spcs_rec = run_query("VW_SPCS_SERVICE_COSTS")
    if not df_spcs_rec.empty:
        pools = df_spcs_rec.groupby("COMPUTE_POOL_NAME", as_index=False)["LIFETIME_CREDITS"].max()
        for _, p in pools.iterrows():
            rec_rows.append({
                "TARGET": str(p["COMPUTE_POOL_NAME"]),
                "SIGNAL": f"{safe_num(p['LIFETIME_CREDITS']):,.1f} lifetime credits",
                "RECOMMENDATION": "Largest cost driver — suspend when idle via the Containers tab",
                "SQL": f"ALTER COMPUTE POOL {p['COMPUTE_POOL_NAME']} SUSPEND;",
                "CREDITS_14D": safe_num(p["LIFETIME_CREDITS"]),
            })

    if rec_rows:
        df_rec = pd.DataFrame(rec_rows).sort_values("CREDITS_14D", ascending=False)
        show_table(axis_label(df_rec, {
            "TARGET": "Target", "SIGNAL": "Signal", "RECOMMENDATION": "Recommended Action",
            "SQL": "SQL", "CREDITS_14D": "Credits (14d)",
        }))
        st.caption("Ordered by spend impact. Copy the SQL column to apply a change manually, or use the controls above.")
    else:
        st.success("No remediation actions required — all monitored resources are within efficiency targets.")


