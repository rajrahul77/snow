        period_note("ACCOUNT_USAGE.QUERY_INSIGHTS — Snowflake's own flags (unfiltered scans, unselective filters, spills). Last 30 days.")
        itype = get_best_col(df_qins, ["INSIGHT_TYPE_ID", "INSIGHT_TYPE"])
