# === HEALTH / Concurrency ===
def render_concurrency():
    section_header(
        "Concurrency & Rightsizing",
        "Inspect peak hours, queued queries, average runtime, and sizing recommendations to balance performance with credit control."
    )

    df_conc = run_query("VW_CONCURRENCY")
    df_peaks = run_query("VW_PEAK_HOURS")

    if not df_conc.empty:
        df_conc = df_conc.copy()
        # Normalize HOUR_SLOT into readable date + hour-of-day columns
        slot_col = get_best_col(df_conc, ["HOUR_SLOT", "USAGE_HOUR", "HOUR"])
        if slot_col:
            raw = df_conc[slot_col].astype(str).str.replace('"', '', regex=False).str.strip()
            parsed = pd.to_datetime(raw, errors="coerce", utc=False)
            if parsed.notna().any():
                df_conc["SLOT_DATE"] = parsed.dt.strftime("%Y-%m-%d")
                df_conc["HOUR_OF_DAY"] = parsed.dt.hour
                df_conc["TIME_SLOT"] = parsed.dt.strftime("%H:00") + " – " + (
                    (parsed.dt.hour + 1) % 24).astype(str).str.zfill(2) + ":00"
                df_conc = df_conc.drop(columns=[slot_col])

        q_col = get_best_col(df_conc, ["QUERIES_IN_HOUR", "QUERY_COUNT"])
        u_col_c = get_best_col(df_conc, ["UNIQUE_USERS"])
        qd_col = get_best_col(df_conc, ["QUEUED_COUNT", "QUEUED"])
        avg_col = get_best_col(df_conc, ["AVG_QUERY_SEC", "AVG_SECONDS"])

        peak_row = df_conc.nlargest(1, q_col).iloc[0] if q_col else None
        total_queued = safe_num(df_conc[qd_col].sum()) if qd_col else 0

        cc1, cc2, cc3, cc4 = st.columns(4)
        with cc1:
            st.metric("Peak Hour Volume",
                      f"{safe_num(peak_row[q_col]):,.0f}" if peak_row is not None else "—",
                      delta="Queries in busiest hour", delta_color="off")
        with cc2:
            st.metric("Peak Time Slot",
                      str(peak_row.get("TIME_SLOT", "-")) if peak_row is not None else "—",
                      delta=str(peak_row.get("SLOT_DATE", "")) if peak_row is not None else "—",
                      delta_color="off")
        with cc3:
            st.metric("Queued Queries", f"{total_queued:,.0f}",
                      delta="Under-provisioned" if total_queued > 0 else "No contention",
                      delta_color="inverse" if total_queued > 0 else "normal")
        with cc4:
            avg_rt = safe_num(df_conc[avg_col].mean()) if avg_col else 0.0
            st.metric("Avg Query Runtime", f"{avg_rt:,.2f} s",
                      delta="Across all slots", delta_color="off")

        if total_queued > 0 and qd_col:
            queued_wh = df_conc[df_conc[qd_col] > 0]
            wh_names = queued_wh[get_best_col(queued_wh, ["WAREHOUSE_NAME"])].unique() if not queued_wh.empty else []
            if len(wh_names) > 0:
                st.warning(
                    f"**Queueing detected on {len(wh_names)} warehouse(s):** {', '.join(map(str, wh_names[:3]))}. "
                    "Consider enabling multi-cluster scaling."
                )

        st.markdown("#### Load Distribution by Hour of Day")
        if "HOUR_OF_DAY" in df_conc.columns and q_col:
            by_hour = df_conc.groupby("HOUR_OF_DAY", as_index=False)[q_col].sum().sort_values("HOUR_OF_DAY")
            by_hour["HOUR_LABEL"] = by_hour["HOUR_OF_DAY"].astype(int).astype(str).str.zfill(2) + ":00"
            by_hour_plot = axis_label(by_hour, {"HOUR_LABEL": "Hour of Day", q_col: "Queries"})
            safe_render_chart("bar", by_hour_plot, ["Hour of Day"], ["Queries"])

        col_c1, col_c2 = st.columns(2)
        with col_c1:
            st.markdown("#### Busiest Hourly Slots")
            show_cols = [c for c in ["SLOT_DATE", "TIME_SLOT", "WAREHOUSE_NAME", q_col, u_col_c, avg_col, qd_col]
                         if c and c in df_conc.columns]
            busiest = df_conc[show_cols].nlargest(20, q_col) if q_col else df_conc[show_cols]
            show_table(axis_label(busiest, {
                "SLOT_DATE": "Date", "TIME_SLOT": "Time Slot", "WAREHOUSE_NAME": "Warehouse",
                q_col: "Queries", u_col_c: "Unique Users", avg_col: "Avg Runtime (s)",
                qd_col: "Queued",
            }))
        with col_c2:
            st.markdown("#### Peak Hours Analysis")
            if not df_peaks.empty:
                show_table(clean_dates(df_peaks, keep_time=True))
            else:
                st.caption("No peak hour data available.")
    else:
        st.caption("No concurrency data detected.")

    st.markdown("---")
    st.markdown("#### Sizing recommendations")
    hint(
        "Snowflake looks at the last 14 days of QUERY_HISTORY. "
        "OK means: fewer than 10% of queries queued, no remote spill, and enough work that shrinking is not obvious."
    )
    df_wh_sizing = run_query("VW_WAREHOUSE_SIZING")
    if df_wh_sizing.empty:
        st.caption("No sizing recommendations available.")
    else:
        rec_col = get_best_col(df_wh_sizing, ["RECOMMENDATION"])
        whs_col = get_best_col(df_wh_sizing, ["WAREHOUSE_NAME", "NAME"])
        rows = []
        for _, r in df_wh_sizing.iterrows():
            verdict, why = explain_sizing(r.get(rec_col) if rec_col else "")
            rows.append({
                "Warehouse": r.get(whs_col),
                "Verdict": verdict,
                "Why": why,
                "Queries (14d)": r.get("TOTAL_QUERIES"),
                "Avg runtime (s)": r.get("AVG_DURATION_SEC"),
                "P95 runtime (s)": r.get("P95_DURATION_SEC"),
                "Queued %": r.get("PCT_QUEUED"),
                "Remote spill (TB)": r.get("REMOTE_SPILL_TB"),
                "Raw rule": r.get(rec_col) if rec_col else "",
            })
        show_df = pd.DataFrame(rows)
        show_table(show_df)
        with st.expander("How OK / upsize / downsize is calculated"):
            st.markdown(
                """
From `VW_WAREHOUSE_SIZING` on the last **14 days** of `QUERY_HISTORY`:

1. **Queued % > 10%** → **Waiting in queue** — queries sat waiting for a warehouse slot. Add a cluster or size up.
2. **Any remote spill** → **Spilling to remote storage** — the warehouse ran out of memory. Size up or rewrite the query.
3. **Average runtime < 0.5s and fewer than 100 queries** → **Consider shrinking** — the warehouse is barely working.
4. **Otherwise → OK** — none of those problems showed up. It does **not** mean the warehouse is cheap or well utilized; idle time is on Spend & idle.
                """
            )

    df_cont = run_query("VW_WAREHOUSE_CONTENTION_ADVISOR", optional=True)
    if not df_cont.empty:
        st.markdown("---")
        st.markdown("#### Warehouse Load vs. Lock Contention Advisor (DO / DO NOT)")
        period_note("WAREHOUSE_LOAD_HISTORY (30d) — separates lock waits (do not upsize) from concurrency queuing (scale out).")
        c_rec = get_best_col(df_cont, ["ACTION_RECOMMENDATION"], default_index=None)
        lock_rows = df_cont[df_cont[c_rec].astype(str).str.upper().str.contains("DO NOT UPSIZE", na=False)] if c_rec else pd.DataFrame()
        scale_rows = df_cont[df_cont[c_rec].astype(str).str.upper().str.contains("SCALE OUT", na=False)] if c_rec else pd.DataFrame()
        light_rows = df_cont[df_cont[c_rec].astype(str).str.upper().str.contains("REDUCE AUTO-SUSPEND", na=False)] if c_rec else pd.DataFrame()
        cw1, cw2, cw3, cw4 = st.columns(4)
        with cw1:
            st.metric("Warehouse-Days Evaluated", f"{len(df_cont)}", delta="30-day load history", delta_color="off")
        with cw2:
            st.metric("Lock-Blocked Days", f"{len(lock_rows)}",
                      delta="DO NOT upsize compute" if len(lock_rows) > 0 else "No lock contention",
                      delta_color="inverse" if len(lock_rows) > 0 else "normal")
        with cw3:
            st.metric("High Queue Load Days", f"{len(scale_rows)}",
                      delta="DO scale out (Multi-Cluster)" if len(scale_rows) > 0 else "No queue overload",
                      delta_color="inverse" if len(scale_rows) > 0 else "normal")
        with cw4:
            st.metric("Light Load Days", f"{len(light_rows)}",
                      delta="DO reduce auto-suspend" if len(light_rows) > 0 else "Balanced",
                      delta_color="off")
        if len(lock_rows) > 0:
            st.warning(
                f"**Lock contention detected on {len(lock_rows)} warehouse-day(s):** "
                "DO NOT upsize warehouse tier — queries are waiting on DML transaction locks (`AVG_BLOCKED_ON_LOCKS`), not compute capacity."
            )
        show_table(axis_label(clean_dates(df_cont).sort_values("USAGE_DATE", ascending=False), {
            "WAREHOUSE_NAME": "Warehouse", "USAGE_DATE": "Date",
            "AVG_RUNNING_QUERIES": "Avg Running", "AVG_QUEUED_LOAD": "Avg Queued (Load)",
            "AVG_QUEUED_PROVISIONING": "Avg Queued (Provisioning)",
            "AVG_BLOCKED_ON_LOCKS": "Avg Blocked (Locks)",
            "ACTION_RECOMMENDATION": "DO / DO NOT Recommendation",
        }))

    df_base = run_query("VW_WAREHOUSE_SIZING_BASELINE", optional=True)
    if not df_base.empty:
        st.markdown("#### Warehouse Sizing Baseline (P50 / P95 & Spill Profile · 30d)")
        show_table(axis_label(df_base, {
            "WAREHOUSE_NAME": "Warehouse", "WAREHOUSE_SIZE": "Current Size",
            "TOTAL_QUERIES": "Queries (30d)", "AVG_DURATION_SEC": "Avg Sec",
            "P50_DURATION_SEC": "P50 Sec", "P95_DURATION_SEC": "P95 Sec",
            "LOCAL_SPILL_GB": "Local Spill GB", "REMOTE_SPILL_GB": "Remote Spill GB",
            "PCT_QUEUED": "Queued %", "CLOUD_CREDITS": "Cloud Credits",
            "ACTIVE_DAYS": "Active Days", "CREDITS_PER_DAY": "Cloud Cr/Day",
        }))

    df_act = run_query("VW_ACTIVE_RESOURCES", optional=True)
    if not df_act.empty:
        st.markdown("#### Active vs. Dormant Warehouse Status (7d)")
        show_table(axis_label(clean_dates(df_act, keep_time=True), {
            "RESOURCE_NAME": "Warehouse", "RESOURCE_TYPE": "Type",
            "CREDITS_7D": "Credits (7d)", "QUERIES_7D": "Queries (7d)",
            "LAST_USED": "Last Metered", "LAST_QUERY_TIME": "Last Query",
            "HOURS_SINCE_LAST_USE": "Hours Since Use",
            "STATUS_RECOMMENDATION": "Status / Recommendation",
        }))


