def render_warehouse():
    section_header(
        "Warehouse infrastructure",
        "Daily warehouse metering: who burned credits, how utilized they were, and how this month compares to last.",
        period="VW_WAREHOUSE_DAILY is one row per warehouse per day — totals are sums of those days, not lifetime",
    )

    df_wh = run_query("VW_WAREHOUSE_DAILY")
    if not df_wh.empty:
        wh_col = get_best_col(df_wh, ["WAREHOUSE_NAME", "NAME"])
        credit_col = get_best_col(df_wh, ["CREDITS_USED", "TOTAL_CREDITS", "CREDITS"])
        wh_date = get_best_col(df_wh, ["USAGE_DATE", "DATE"])
        full_span = window_span(df_wh, wh_date)

        if wh_col:
            st.markdown("#### Warehouse spend")
            hint("Pick the warehouses you care about. The line is their daily burn in the window.")
            fc1, fc2 = st.columns([2, 1])
            with fc1:
                warehouses = sorted(df_wh[wh_col].unique())
                selected_wh = st.multiselect("Filter warehouses", warehouses, default=warehouses[:5])
            with fc2:
                wh_grain = drill_control("wh_grain", default="Date")

            scoped = df_wh[df_wh[wh_col].isin(selected_wh)].copy()
            span = window_span(scoped, wh_date) if wh_date else full_span

            total_credits = safe_num(scoped[credit_col].sum()) if credit_col else 0.0
            peak_day_val = 0.0
            peak_wh = "—"
