        total_cb = safe_num(df_cb[c_col].sum()) if c_col else 0.0
        col1, col2, col3 = st.columns(3)
        with col1:
            kpi("Attributed spend · view sum", f"{total_cb:,.1f} cr", period="Sum of tagged warehouse metering in VW_CHARGEBACK.")
        with col2:
            kpi("UNTAGGED warehouses", f"{untagged:,.1f} cr",
                period="Credits on warehouses with no COST_CENTER / TEAM / DEPARTMENT tag. Tag them for chargeback.")
        with col3:
            n_cc = df_cb[cc_col].nunique() if cc_col else 0
            kpi("Cost centers", f"{n_cc}", period="Distinct tag values including UNTAGGED.")

        st.markdown("#### Credits by cost center")
        if not by_cc.empty:
            safe_render_chart("bar", axis_label(by_cc, {cc_col: "Cost center", c_col: "Credits (view sum)"}),
