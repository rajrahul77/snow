        show_table(axis_label(df_prune_adv.sort_values("PARTITIONS_SCANNED", ascending=False).head(50), {
            "DATABASE_NAME": "Database", "SCHEMA_NAME": "Schema", "TABLE_NAME": "Table",
            "COLUMN_NAME": "Column", "ACCESS_TYPE": "Access Type", "TOTAL_QUERIES": "Queries (30d)",
            "PARTITIONS_SCANNED": "Partitions Scanned", "PARTITIONS_PRUNED": "Partitions Pruned",
            "OPTIMA_PARTITIONS_PRUNED": "Optima Pruned", "PRUNE_EFFICIENCY_PCT": "Prune Efficiency %",
            "OPTIMA_INDEXING_APPLIED": "Optima Indexing", "OPTIMA_CLUSTERING_APPLIED": "Optima Clustering",
            "ACTION_RECOMMENDATION": "DO / DO NOT Recommendation",
        }))


