    if not col or col not in df.columns:
        return pd.Series([""] * len(df), index=df.index)
    return df[col].astype(str).str.upper().str.replace("-", "_").str.replace(" ", "_")


def tag_cost_center(df):
    """Label each row USER or SYSTEM so platform spend is never mixed into a person."""
    if df is None or df.empty:
        return df
    out = df.copy()
    user_col = get_best_col(out, ["USER_NAME", "USER"], default_index=None)
    svc_col = get_best_col(out, ["SERVICE_TYPE", "SERVICE"], default_index=None)
    sys_mask = pd.Series(False, index=out.index)
    if user_col:
        u = out[user_col].astype(str).str.upper()
        sys_mask = sys_mask | u.isin(SYSTEM_USER_NAMES) | u.str.startswith("SYSTEM")
    if svc_col:
        s = _upper_series(out, svc_col)
        sys_mask = sys_mask | s.isin(SYSTEM_SERVICES)
    if "COST_CENTER" in out.columns:
        existing = out["COST_CENTER"].astype(str).str.upper()
        out.loc[existing.eq("SYSTEM") | sys_mask, "COST_CENTER"] = "SYSTEM"
        out.loc[out["COST_CENTER"].astype(str).str.upper() != "SYSTEM", "COST_CENTER"] = "USER"
    else:
        out["COST_CENTER"] = "USER"
        out.loc[sys_mask, "COST_CENTER"] = "SYSTEM"
    if user_col:
        out.loc[out["COST_CENTER"].eq("SYSTEM"), user_col] = "SYSTEM"
    return out


def usage_source_label(df):
    """Warehouse / Snowsight / AI / Cloud services / System — for stacked charts."""
    if df is None or df.empty:
        return df
    out = df.copy()
    svc = _upper_series(out, get_best_col(out, ["SERVICE_TYPE", "SERVICE"], default_index=None))
    client = _upper_series(out, get_best_col(out, ["CLIENT_TYPE", "CLIENT", "APPLICATION"], default_index=None))
    center = out["COST_CENTER"].astype(str).str.upper() if "COST_CENTER" in out.columns else pd.Series([""] * len(out), index=out.index)
    source = pd.Series(["Warehouse"] * len(out), index=out.index)
    source = source.where(~svc.str.contains("AI|CORTEX", regex=True, na=False), "AI / Cortex")
    source = source.where(~svc.str.contains("CLOUD_SERVICES", na=False), "Cloud services")
    snow_client = client.apply(lambda v: any(m.replace(" ", "_") in str(v) for m in SNOWSIGHT_MARKERS) or "SNOWSIGHT" in str(v))
    snow_svc = svc.eq("SNOWSIGHT")
    source = source.where(~(snow_client | snow_svc), "Snowsight")
    source = source.where(~center.eq("SYSTEM"), "System")
    out["USAGE_SOURCE"] = source
    return out


