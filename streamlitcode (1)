def safe_num(value, default=0.0):
    try:
        if value is None:
            return default
        if isinstance(value, (pd.Series, pd.Index)):
            return float(pd.to_numeric(value, errors="coerce").fillna(0).sum())
        if pd.isna(value):
            return default
        return float(value)
    except Exception:
        return default


def fmt_compact(value, suffix="", decimals=1):
    value = safe_num(value)
    sign = "-" if value < 0 else ""
    value = abs(value)
    if value >= 1_000_000:
        return f"{sign}{value / 1_000_000:.{decimals}f}M{suffix}"
    if value >= 1_000:
        return f"{sign}{value / 1_000:.{decimals}f}K{suffix}"
    return f"{sign}{value:,.{decimals}f}{suffix}"


def pct(part, total, default=0.0):
    total = safe_num(total)
    return default if total == 0 else safe_num(part) / total * 100


def get_best_col(df, candidates):
    if df is None or df.empty:
        return None
    lookup = {c.upper(): c for c in df.columns}
    for candidate in candidates:
        if candidate and candidate.upper() in lookup:
            return lookup[candidate.upper()]
    return None


def clean_dates(df, cols=None, keep_time=False):
    if df is None or df.empty:
        return pd.DataFrame()
    out = df.copy()
    targets = cols or [
        c for c in out.columns
        if any(token in c.upper() for token in ("DATE", "TIME", "CREATED_ON", "SLOT", "LOGIN"))
    ]
    for col in targets:
        if col not in out.columns:
            continue
        try:
            raw = out[col].astype(str).str.replace('"', "", regex=False).str.strip()
            parsed = pd.to_datetime(raw, errors="coerce")
            if parsed.notna().any():
                out[col] = parsed.dt.strftime("%Y-%m-%d %H:%M" if keep_time else "%Y-%m-%d").fillna("")
            else:
                out[col] = raw
        except Exception:
            pass
    return out


def prepare_frame(df):
    if df is None or df.empty:
        return pd.DataFrame()
    out = df.copy()
    for col in out.columns:
        if pd.api.types.is_datetime64_any_dtype(out[col]):
            out[col] = out[col].dt.strftime("%Y-%m-%d").fillna("")
            continue
        if out[col].dtype == "object":
            raw = out[col].astype(str).str.replace('"', "", regex=False).str.strip()
            date_probe = pd.to_datetime(raw, errors="coerce")
            if len(raw.dropna()) > 0 and date_probe.notna().mean() > 0.85:
                has_time = bool((date_probe.dt.hour.fillna(0) != 0).any() or (date_probe.dt.minute.fillna(0) != 0).any())
                out[col] = date_probe.dt.strftime("%Y-%m-%d %H:%M" if has_time else "%Y-%m-%d").fillna("")
                continue
            numeric = pd.to_numeric(raw, errors="coerce")
            if numeric.notna().mean() > 0.85:
                out[col] = numeric.fillna(0)
            else:
                out[col] = raw.fillna("")
    return out


