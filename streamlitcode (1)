# === RISK / Budget ===
def render_burndown():
    section_header(
        "Budget burn-down",
        "This calendar month only: month-to-date credits, daily rate, and a projected month-end.",
        period="MTD = 1st of this month → latest day · Projected EOM = current daily rate × days in this month",
    )

    df_burn = run_query("VW_BUDGET_BURNDOWN")
    df_rate = run_query("VW_BUDGET_BURN_RATE")
    df_guard = run_query("VW_GOVERNANCE_GUARDRAILS", optional=True)

    configured_budget = 0
    budget_name_label = ""
    if not df_guard.empty and "GUARDRAIL_TYPE" in df_guard.columns:
        b_rows = df_guard[df_guard["GUARDRAIL_TYPE"].astype(str).str.upper().eq("BUDGET")]
        if not b_rows.empty and "CREDIT_QUOTA" in b_rows.columns:
            configured_budget = int(round(safe_num(b_rows["CREDIT_QUOTA"].sum())))
            budget_name_label = str(b_rows.iloc[0].get("NAME", "ACCOUNT_ROOT_BUDGET"))

    if not df_burn.empty:
        mtd_col = get_best_col(df_burn, ["MTD_CREDITS", "MTD_SPEND"], default_index=None)
        if mtd_col:
            latest = df_burn.iloc[-1]
            mtd = safe_num(latest[mtd_col])
            avg_rate = safe_num(latest.get("AVG_DAILY_RATE", 1.0))
            projected_eom = safe_num(latest.get("PROJECTED_EOM", mtd))
            days_remaining = safe_num(latest.get("DAYS_REMAINING", 0))

            # Use live configured Snowflake Budget when available, else auto-derive from trend
            derived_budget = configured_budget if configured_budget >= 10 else (
                int(((projected_eom // 10) + 1) * 10) if projected_eom > 0 else 50
            )

            if configured_budget >= 10:
                st.caption(
                    f"Initialized from live Snowflake Budget **{budget_name_label}** (**{configured_budget:,} credits** monthly cap). "
                    f"Projected end-of-month is **{projected_eom:,.1f} credits** at {avg_rate:,.2f} cr/day."
                )
            else:
                st.caption(
                    f"Scenario only — no active Snowflake Budget found. Baseline derived from your consumption trend: projected end-of-month is "
                    f"**{projected_eom:,.1f} credits** at the current daily rate of {avg_rate:,.2f}."
                )
            monthly_budget = st.slider(
                "Allocation / Scenario Target (Credits)",
                min_value=10,
                max_value=max(500, derived_budget * 3),
                value=derived_budget,
                step=10,
                help="Defaults to your live ACCOUNT_USAGE.BUDGET_DETAILS cap (or trend projection). Adjust in steps of 10 to model scenarios."
            )

            budget_remaining = monthly_budget - mtd
            burn_pct = int((mtd / monthly_budget) * 100) if monthly_budget > 0 else 0
            will_overrun = projected_eom > monthly_budget
            # Runway is capped to the days actually left in the month
            raw_runway_bd = int(budget_remaining / avg_rate) if avg_rate > 0 else int(days_remaining)
            runway_bd = max(0, min(raw_runway_bd, int(days_remaining)))
            covers_month_bd = raw_runway_bd >= days_remaining
            headroom_healthy = budget_remaining > 0

            col_b1, col_b2, col_b3, col_b4 = st.columns(4)
            with col_b1:
                st.metric("MTD Consumption", f"{mtd:,.2f} cr",
                          delta=f"{avg_rate:,.2f} cr/day", delta_color="inverse")
            with col_b2:
                st.metric("Scenario Utilization", f"{burn_pct}%",
                          delta="On track" if burn_pct < 85 else "High usage",
                          delta_color="normal" if burn_pct < 85 else "inverse")
            with col_b3:
                st.metric("Runway (this month)", f"{runway_bd} of {int(days_remaining)} days",
                          delta="Covers month end" if covers_month_bd else "Runs out early",
                          delta_color="normal" if covers_month_bd else "inverse")
            with col_b4:
                st.metric("Projected End-of-Month", f"{projected_eom:,.1f} cr",
                          delta="Above scenario" if will_overrun else "Within scenario",
                          delta_color="inverse" if will_overrun else "normal")

            st.progress(max(0.0, min(burn_pct / 100, 1.0)))
            st.caption(f"Day {int(safe_num(latest.get('DAY_NUMBER', 0)))} of "
                       f"{int(safe_num(latest.get('DAYS_IN_MONTH', 30)))} — {burn_pct}% of target consumed")

            if will_overrun:
                overshoot = projected_eom - monthly_budget
                st.error(
                    f"At the current rate you will exceed the allocation by **{overshoot:,.1f} credits**. "
                    f"Reduce daily burn below {max(0, monthly_budget - mtd) / max(days_remaining, 1):,.2f} cr/day to stay within target."
                )
            else:
                st.success(f"On track — projected to finish {monthly_budget - projected_eom:,.1f} credits under allocation.")

            df_burn_chart = clean_dates(df_burn.copy(), ["USAGE_DATE"])
            df_burn_chart["ALLOCATION_TARGET"] = monthly_budget

            st.markdown("#### Cumulative Spend vs Allocation Target")
            bd_grain = drill_control("burn_grain", default="Date")
            bd_chart = apply_drill(df_burn_chart, "USAGE_DATE", [mtd_col], bd_grain, agg="max", drill_key="burn_grain")
            if "ALLOCATION_TARGET" not in bd_chart.columns:
                bd_chart["ALLOCATION_TARGET"] = monthly_budget
            bd_chart = axis_label(bd_chart, {
                "USAGE_DATE": bd_grain, mtd_col: "Cumulative Credits",
                "ALLOCATION_TARGET": "Target",
            })
            safe_render_chart("line", bd_chart, [bd_grain],
                              ["Cumulative Credits", "Target"], multi_y=True)

            st.markdown("#### Daily Consumption Detail")
            show_table(axis_label(
                df_burn_chart.sort_values("USAGE_DATE", ascending=False),
                {"USAGE_DATE": "Date", "DAILY_CREDITS": "Daily Credits",
                 mtd_col: "MTD Credits", "DAY_NUMBER": "Day",
                 "DAYS_IN_MONTH": "Days in Month", "DAYS_REMAINING": "Days Left",
                 "AVG_DAILY_RATE": "Avg Daily Rate", "PROJECTED_EOM": "Projected EOM",
                 "ALLOCATION_TARGET": "Target"}
            ))

    if not df_rate.empty:
        st.markdown("#### Hourly Consumption Velocity")
        show_table(clean_dates(df_rate, keep_time=True))

    if not df_guard.empty:
        st.markdown("---")
        st.markdown("#### Configured Budgets & Resource Monitor Guardrails (DO / DO NOT)")
        period_note("Live SNOWFLAKE.ACCOUNT_USAGE.BUDGET_DETAILS + RESOURCE_MONITORS.")
        g_type = get_best_col(df_guard, ["GUARDRAIL_TYPE"], default_index=None)
        g_rec = get_best_col(df_guard, ["ACTION_RECOMMENDATION"], default_index=None)
        rm_rows = df_guard[df_guard[g_type].astype(str).str.upper().eq("RESOURCE_MONITOR")] if g_type else pd.DataFrame()
        notify_only = (
            rm_rows[rm_rows[g_rec].astype(str).str.upper().str.contains("DO NOT", na=False)]
            if (not rm_rows.empty and g_rec) else pd.DataFrame()
        )
        cg1, cg2, cg3, cg4 = st.columns(4)
        with cg1:
            st.metric("Configured Budget", f"{configured_budget:,} cr" if configured_budget > 0 else "None",
                      delta=budget_name_label or "No root budget", delta_color="off")
        with cg2:
            st.metric("Resource Monitors", f"{len(rm_rows)}",
                      delta="Active monitors", delta_color="off")
        with cg3:
            st.metric("Notify-Only Monitors", f"{len(notify_only)}",
                      delta="Missing hard SUSPEND" if len(notify_only) > 0 else "All protected",
                      delta_color="inverse" if len(notify_only) > 0 else "normal")
        with cg4:
            max_pct = safe_num(df_guard["PCT_USED"].max()) if "PCT_USED" in df_guard.columns else 0.0
            st.metric("Peak Guardrail Used", f"{max_pct:.1f}%",
                      delta="Above 85% threshold" if max_pct >= 85 else "Within limits",
                      delta_color="inverse" if max_pct >= 85 else "normal")
        if len(notify_only) > 0:
            names_no = ", ".join(notify_only["NAME"].astype(str).tolist()[:4]) if "NAME" in notify_only.columns else ""
            st.warning(
                f"**Guardrail gap ({len(notify_only)} monitor(s): {names_no}):** "
                "DO NOT leave Resource Monitors notify-only — configure a `SUSPEND` threshold so runaway queries cannot exceed your cap."
            )
        show_table(axis_label(df_guard, {
            "GUARDRAIL_TYPE": "Guardrail Type", "NAME": "Name",
            "CREDIT_QUOTA": "Credit Quota", "USED_CREDITS": "Used Credits",
            "PCT_USED": "% Used", "SUSPEND_AT_PCT": "Suspend At %",
            "ACTION_RECOMMENDATION": "DO / DO NOT Recommendation",
        }))


