def grain_selector(key):
    try:
        value = st.segmented_control("Granularity", ["Day", "Week", "Month"], default="Day", key=key)
        return value or "Day"
    except Exception:
        return st.radio("Granularity", ["Day", "Week", "Month"], horizontal=True, key=key)


def aggregate_by_date(df, date_col, value_cols, grain="Day", group_col=None, agg="sum"):
    if df.empty or not date_col:
        return pd.DataFrame()
    out = df.copy()
    parsed = pd.to_datetime(out[date_col], errors="coerce")
    out = out[parsed.notna()].copy()
    if out.empty:
        return pd.DataFrame()
    parsed = pd.to_datetime(out[date_col], errors="coerce")
    if grain == "Month":
        out[date_col] = parsed.dt.to_period("M").dt.to_timestamp()
    elif grain == "Week":
        out[date_col] = parsed.dt.to_period("W").apply(lambda p: p.start_time)
    else:
        out[date_col] = parsed.dt.date
    cols = [c for c in value_cols if c in out.columns]
    keys = [date_col] + ([group_col] if group_col and group_col in out.columns else [])
    if not cols:
        return pd.DataFrame()
    grouped = out.groupby(keys, as_index=False)[cols].agg(agg).sort_values(date_col)
    grouped[date_col] = pd.to_datetime(grouped[date_col]).dt.strftime("%Y-%m-%d")
    return grouped


def user_context():
