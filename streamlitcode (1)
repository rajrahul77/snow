# On-demand list prices from the Snowflake Service Consumption Table
# (effective March 2026, AWS US East / US West). Other regions cost more.
# Trial is not a separate rate: you pick an edition at signup and burn $400
# of free usage at that edition's on-demand price.
LIST_PRICE_USD = {
    "standard": 2.00,
    "enterprise": 3.00,
    "business_critical": 4.00,
    "vps": 6.00,
}
REGION_MULTIPLIER = {
    "AWS_US_EAST": 1.00, "AWS_US_WEST": 1.00, "AWS_US_EAST_1": 1.00, "AWS_US_WEST_2": 1.00,
    "AZURE_EASTUS2": 1.00, "AZURE_WESTUS2": 1.00, "GCP_US_CENTRAL1": 1.00,
    "AWS_EU": 1.30, "AWS_EU_WEST_1": 1.30, "AWS_EU_CENTRAL_1": 1.35,
    "AWS_AP": 1.35, "AWS_AP_SOUTHEAST_2": 1.35, "AWS_AP_SOUTHEAST_1": 1.40,
}


def _edition_key(text):
    blob = str(text or "").upper().replace("-", " ").replace("_", " ")
    if "VPS" in blob or "VIRTUAL PRIVATE" in blob:
        return "vps"
    if "BUSINESS" in blob or "CRITICAL" in blob:
        return "business_critical"
    if "ENTERPRISE" in blob:
        return "enterprise"
    if "STANDARD" in blob or "TRIAL" in blob:
        return "standard"
    return ""


def _region_multiplier(region):
    blob = str(region or "").upper().replace("-", "_")
    if blob in REGION_MULTIPLIER:
        return REGION_MULTIPLIER[blob]
    if "EU_" in blob or blob.endswith("_EU") or "EUROPE" in blob:
        return 1.30
    if "AP_" in blob or "ASIA" in blob or "AUSTRALIA" in blob:
        return 1.35
    return 1.00


def _list_price(edition_key, region=""):
    base = LIST_PRICE_USD.get(edition_key) or LIST_PRICE_USD["enterprise"]
    return round(base * _region_multiplier(region), 2)


def _detect_account_profile(backend):
    """Read edition and $ / credit from Snowflake, else fall back to the consumption table."""
    profile = {
        "account_locator": "",
        "account_name": "",
        "region": "",
        "edition": "Enterprise",
        "edition_key": "enterprise",
        "is_trial": False,
        "rate": LIST_PRICE_USD["enterprise"],
        "currency": "USD",
        "source": "List price — Enterprise $3 / credit (AWS US on-demand)",
        "detected": False,
    }
    if backend == "demo":
        profile["account_name"] = "PREVIEW"
        profile["source"] = "Preview — pick the edition in Controls (Snowflake list prices)"
        return profile

    conn = get_snowflake_conn()
    try:
        ctx = conn.query(
            "SELECT CURRENT_ACCOUNT() AS LOCATOR, CURRENT_ACCOUNT_NAME() AS NAME, "
            "CURRENT_REGION() AS REGION",
            ttl=0,
        )
        if ctx is not None and not ctx.empty:
            profile["account_locator"] = str(ctx["LOCATOR"].iloc[0])
            profile["account_name"] = str(ctx["NAME"].iloc[0])
            profile["region"] = str(ctx["REGION"].iloc[0])
    except Exception:
        pass

    edition_raw = ""
    try:
        accts = conn.query(
            "SELECT ACCOUNT_LOCATOR, ACCOUNT_NAME, EDITION "
            "FROM SNOWFLAKE.ORGANIZATION_USAGE.ACCOUNTS "
            "WHERE ACCOUNT_LOCATOR = CURRENT_ACCOUNT() LIMIT 1",
            ttl=0,
        )
        if accts is not None and not accts.empty:
            edition_raw = str(accts.iloc[0].get("EDITION") or "")
            if edition_raw:
                profile["edition"] = edition_raw
                profile["detected"] = True
    except Exception:
        pass

    rate_val = None
    service_level = ""
    try:
        rates = conn.query(
            "SELECT DATE, SERVICE_LEVEL, SERVICE_TYPE, RATING_TYPE, "
            "EFFECTIVE_RATE, CURRENCY, ACCOUNT_LOCATOR "
            "FROM SNOWFLAKE.ORGANIZATION_USAGE.RATE_SHEET_DAILY "
            "WHERE DATE >= DATEADD('day', -30, CURRENT_DATE()) "
            "  AND ACCOUNT_LOCATOR = CURRENT_ACCOUNT() "
            "  AND EFFECTIVE_RATE > 0 "
            "ORDER BY DATE DESC LIMIT 80",
            ttl=0,
        )
        if rates is not None and not rates.empty:
            cols = {c.upper(): c for c in rates.columns}
            rate_c = cols.get("EFFECTIVE_RATE")
            type_c = cols.get("RATING_TYPE")
            svc_c = cols.get("SERVICE_TYPE")
            level_c = cols.get("SERVICE_LEVEL")
            cur_c = cols.get("CURRENCY")
            subset = rates
            if type_c:
                compute = subset[type_c].astype(str).str.lower().eq("compute")
                if compute.any():
                    subset = subset[compute]
            elif svc_c:
                wh = subset[svc_c].astype(str).str.upper().str.contains(
                    "WAREHOUSE|COMPUTE", regex=True, na=False)
                if wh.any():
                    subset = subset[wh]
            if rate_c is not None and not subset.empty:
                rate_val = safe_num(pd.to_numeric(subset[rate_c], errors="coerce").median())
            if level_c is not None and not subset.empty:
                service_level = str(subset.iloc[0][level_c])
            if cur_c is not None and not subset.empty:
                profile["currency"] = str(subset.iloc[0][cur_c] or "USD")
            profile["detected"] = True
    except Exception:
        pass

    if not rate_val:
        try:
            implied = conn.query(
                "SELECT ROUND(SUM(USAGE_IN_CURRENCY) / NULLIF(SUM(USAGE), 0), 4) AS RATE "
                "FROM SNOWFLAKE.ORGANIZATION_USAGE.USAGE_IN_CURRENCY_DAILY "
                "WHERE ACCOUNT_LOCATOR = CURRENT_ACCOUNT() "
                "  AND USAGE_DATE >= DATEADD('day', -30, CURRENT_DATE()) "
                "  AND USAGE > 0",
                ttl=0,
            )
            if implied is not None and not implied.empty:
                rate_val = safe_num(implied.iloc[0, 0])
                if rate_val > 0:
                    profile["detected"] = True
        except Exception:
            pass

    has_contract = None
    try:
        items = conn.query(
            "SELECT COUNT(*) AS N FROM SNOWFLAKE.ORGANIZATION_USAGE.CONTRACT_ITEMS",
            ttl=0,
        )
        if items is not None and not items.empty:
            has_contract = safe_num(items.iloc[0, 0]) > 0
    except Exception:
        pass

    edition_key = _edition_key(edition_raw) or _edition_key(service_level) or "enterprise"
    profile["edition_key"] = edition_key
    pretty = {
        "standard": "Standard",
        "enterprise": "Enterprise",
        "business_critical": "Business Critical",
        "vps": "VPS",
    }[edition_key]
    profile["edition"] = edition_raw or service_level or pretty
    profile["is_trial"] = has_contract is False

    if rate_val and rate_val > 0:
        profile["rate"] = round(rate_val, 4)
        profile["source"] = (
            f"{'Trial · ' if profile['is_trial'] else ''}"
            f"{profile['edition']} — ${profile['rate']:.2f} / credit from rate sheet"
        )
    else:
        profile["rate"] = _list_price(edition_key, profile["region"])
        trial_bit = "Trial · " if profile["is_trial"] else ""
        profile["source"] = (
            f"{trial_bit}{pretty} list price ${profile['rate']:.2f} / credit "
            "(Snowflake Service Consumption Table, on-demand)"
        )
    return profile
def detect_account_profile(backend):
    now = time.monotonic()
    scope = (APP_BUILD, SCHEMA, backend, st.session_state.get("_finops_security_fingerprint", ()))
    cached = st.session_state.get("_finops_profile_cache")
    if cached and cached["scope"] == scope and cached["expires"] > now:
        return dict(cached["value"])
    profile = _detect_account_profile(backend)
    st.session_state["_finops_profile_cache"] = {
        "scope": scope, "expires": time.monotonic() + 3600, "value": dict(profile)}
    return profile


