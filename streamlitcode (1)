    rank = valid.groupby(names)["_credits"].sum().sort_values(ascending=False).rename_axis("Driver").reset_index(name="Credits")
    total = float(rank["Credits"].sum())
    rank["Share"] = rank["Credits"] / total if total > 0 else 0.0
