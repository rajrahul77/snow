def apply_drill(df, date_col, value_cols, grain, agg="sum", group_col=None, drill_key=None):
    """Aggregates a date-based frame to Date / Month / Year granularity.
    When drill_key is provided, a contextual period filter is shown first."""
    if df is None or df.empty or date_col not in df.columns:
        return df

    # Apply progressive filter if a drill_key was given
    if drill_key:
        df = _drill_period_filter(df, date_col, grain, drill_key)

    out = df.copy()
    raw = out[date_col].astype(str).str.replace('"', '', regex=False).str.strip()
    parsed = pd.to_datetime(raw, errors="coerce")
    if parsed.isna().all():
        return out

    if grain == "Month":
        out[date_col] = parsed.dt.to_period("M").dt.to_timestamp()
    elif grain == "Year":
        out[date_col] = parsed.dt.to_period("Y").dt.to_timestamp()
    else:
        out[date_col] = parsed.dt.normalize()

    value_cols = [c for c in (value_cols or []) if c and c in out.columns
                  and pd.api.types.is_numeric_dtype(out[c])]
    if not value_cols:
        return out

    keys = [date_col] + ([group_col] if group_col and group_col in out.columns else [])
    try:
        out = out.groupby(keys, as_index=False)[value_cols].agg(agg)
        out = out.sort_values(date_col)
        out[date_col] = out[date_col].dt.strftime("%m/%Y" if grain == "Month" else "%Y" if grain == "Year" else "%Y-%m-%d")
        return out
    except Exception:
        return out


def clean_dates(df, cols=None, keep_time=False):
    """Strips quote artifacts and timezone noise from date/timestamp columns."""
    if df is None or df.empty:
        return df
    df = df.copy()
    targets = cols if cols else [
        c for c in df.columns
        if any(k in c.upper() for k in ["DATE", "TIME", "CREATED_ON", "SLOT", "LOGIN"])
    ]
    for col in targets:
        if col not in df.columns:
            continue
        try:
            cleaned = df[col].astype(str).str.replace('"', '', regex=False).str.strip()
            parsed = pd.to_datetime(cleaned, errors="coerce", utc=False)
            if parsed.notna().any():
                fmt = "%Y-%m-%d %H:%M" if keep_time else "%Y-%m-%d"
                df[col] = parsed.dt.strftime(fmt).fillna("")
            else:
                df[col] = cleaned
        except Exception:
            pass
    return df


def get_best_col(df, candidates, default_index=0):
    """Finds the first existing candidate column in DataFrame or falls back safely."""
    if df is None or df.empty:
        return None
    for col in candidates:
        if col in df.columns:
            return col
    if default_index is None:
        return None
    if len(df.columns) > default_index:
        return df.columns[default_index]
    return None


def _pretty_field_name(name):
    """Turns Snowflake column names into compact labels used in hover cards."""
    return str(name).replace("_", " ").strip().title()


def _alt_type(df, col, x_axis=False):
    """Returns an Altair type without mutating the dashboard data."""
    if col not in df.columns:
        return "nominal"
    if pd.api.types.is_numeric_dtype(df[col]):
        return "quantitative"
    upper = str(col).upper()
    if x_axis and any(token in upper for token in ("DATE", "DAY", "MONTH", "YEAR", "TIME", "SLOT")):
        return "ordinal"
    return "nominal"


def _tooltip_fields(df, x_col, y_cols, color_col=None, max_fields=8):
    """Builds the detailed Snowflake-style hover card shown on every chart."""
    ordered = []

    def add(col):
        if col and col in df.columns and col not in ordered:
            ordered.append(col)

    add(x_col)
    add(color_col)
    for col in y_cols:
        add(col)

    # Prefer operational context over arbitrary dataframe column order.
    context_tokens = (
        "WAREHOUSE_NAME", "SERVICE_TYPE", "USER_NAME", "DATABASE_NAME",
        "QUERY_TYPE", "FUNCTION_NAME", "MODEL_NAME", "WAREHOUSE_SIZE",
        "EXECUTION", "DURATION", "ELAPSED", "CREDIT", "COST", "USD",
        "USAGE", "TOKEN", "INVOCATION", "STATUS", "SCORE", "GB", "MB",
    )
    for token in context_tokens:
        for col in df.columns:
            if token in str(col).upper():
                add(col)
            if len(ordered) >= max_fields:
                break
        if len(ordered) >= max_fields:
            break

    tooltips = []
    for col in ordered[:max_fields]:
        data_type = _alt_type(df, col)
        kwargs = {"field": col, "type": data_type, "title": _pretty_field_name(col)}
        if data_type == "quantitative":
            kwargs["format"] = ",.2f"
        tooltips.append(kwargs)
    return tooltips


def safe_render_chart(chart_type, df, x_candidates, y_candidates, color_candidates=None, multi_y=False, height=280):
    """
    Renders charts safely by resolving actual columns dynamically.
    When multi_y is False (default), picks ONLY ONE single best matching Y column to prevent duplicate unit stacking.
    """
    if df is None or df.empty:
        empty_state("No chart data available for the selected filters.")
        return
    
    x_col = get_best_col(df, x_candidates, 0)
    
    if isinstance(y_candidates, list):
        if multi_y:
            existing_y = [c for c in y_candidates if c in df.columns]
            y_col = existing_y if len(existing_y) > 1 else (existing_y[0] if existing_y else None)
        else:
            # Pick ONLY the top priority matching column (e.g., DISPLAY_COST first)
            y_col = None
            for c in y_candidates:
                if c in df.columns:
                    y_col = c
                    break
            if not y_col:
                y_col = get_best_col(df, y_candidates, 1 if len(df.columns) > 1 else 0)
    else:
        y_col = get_best_col(df, [y_candidates], 1 if len(df.columns) > 1 else 0)
        
    color_col = None
    if color_candidates:
        color_col = get_best_col(df, color_candidates if isinstance(color_candidates, list) else [color_candidates], None)

    if not x_col or not y_col:
        show_table(df, height=height)
        return

    grain_label = {"date": "Day", "day": "Day", "month": "Month", "year": "Year"}.get(str(x_col).lower())
    if grain_label:
        st.caption(f"Granularity · {grain_label}")

    try:
        chart_df = _scale_spend_frame(df.copy(), y_col)
        if isinstance(y_col, list):
            y_col = [_rename_spend_axis(c) if c in chart_df.columns or _rename_spend_axis(c) in chart_df.columns else c for c in y_col]
            y_col = [c if c in chart_df.columns else _rename_spend_axis(c) for c in y_col]
        else:
            renamed = _rename_spend_axis(y_col)
            if renamed in chart_df.columns:
                y_col = renamed
        axis = {
            "labelColor": "#64748b", "titleColor": "#475569", "domainColor": "#cbd5e1",
            "tickColor": "#cbd5e1", "gridColor": "#eef2f7", "labelFontSize": 11,
            "titleFontSize": 12, "labelPadding": 7, "titlePadding": 12,
        }
        legend = {
            "orient": "bottom", "direction": "horizontal", "title": None,
            "labelColor": "#475569", "labelFontSize": 11,
        }

        # Multiple measures are folded into a long frame so each measure gets
        # its own legend entry and precise value in the hover card.
        if isinstance(y_col, list):
            melt_cols = [c for c in y_col if c in chart_df.columns]
            id_cols = [c for c in [x_col, color_col] if c and c in chart_df.columns]
            long_df = chart_df[id_cols + melt_cols].melt(
                id_vars=id_cols, value_vars=melt_cols,
                var_name="Metric", value_name="Value"
            )
            enc = {
                "x": {"field": x_col, "type": _alt_type(long_df, x_col, True),
                      "title": _pretty_field_name(x_col), "axis": axis},
                "y": {"field": "Value", "type": "quantitative", "title": "Value", "axis": axis, "stack": None},
                "color": {
                    "field": "Metric", "type": "nominal", "legend": legend,
                    "scale": {"range": ["#137f8b", "#5475b8", "#9280b7", "#d39845", "#c96868"]},
                },
                "tooltip": [
                    {"field": x_col, "type": _alt_type(long_df, x_col), "title": _pretty_field_name(x_col)},
                    {"field": "Metric", "type": "nominal", "title": "Metric"},
                    {"field": "Value", "type": "quantitative", "title": "Value", "format": ",.2f"},
                ],
            }
            source = long_df
        else:
            y_name = y_col
            x_type = _alt_type(chart_df, x_col, True)
            enc = {
                "x": {"field": x_col, "type": x_type,
                      "title": _pretty_field_name(x_col), "axis": axis},
                "y": {"field": y_name, "type": "quantitative",
                      "title": _pretty_field_name(y_name), "axis": axis},
                "tooltip": _tooltip_fields(chart_df, x_col, [y_name], color_col),
            }
            if color_col and color_col in chart_df.columns:
                enc["color"] = {
                    "field": color_col, "type": "nominal", "title": _pretty_field_name(color_col),
                    "legend": legend,
                    "scale": {"range": ["#137f8b", "#5475b8", "#9280b7", "#d39845", "#c96868", "#4e9d87"]},
                }
            chart_fields = [x_col, y_name] + ([color_col] if color_col else [])
            chart_fields += [item["field"] for item in enc["tooltip"]]
            source = chart_df[list(dict.fromkeys(c for c in chart_fields if c in chart_df.columns))]

        if chart_type == "bar":
            mark = {"type": "bar", "cornerRadiusTopLeft": 3, "cornerRadiusTopRight": 3, "opacity": 0.94}
        elif chart_type == "area":
            mark = {"type": "area", "opacity": 0.58, "line": {"strokeWidth": 2}}
        elif chart_type == "scatter":
            mark = {"type": "circle", "size": 82, "opacity": 0.82,
                    "stroke": "#ffffff", "strokeWidth": 1}
        else:
            mark = {"type": "line", "strokeWidth": 2.4,
                    "point": {"size": 48, "filled": True}}

        if "color" not in enc:
            mark["color"] = "#137f8b"
        if enc["x"]["type"] in ("ordinal", "nominal"):
            enc["x"]["sort"] = None
        spec = {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "mark": mark,
            "encoding": enc,
            "height": height,
            "background": "#ffffff",
            "padding": {"left": 6, "right": 14, "top": 12, "bottom": 6},
            "config": {
                "view": {"stroke": None},
                "axis": {"labelLimit": 150, "titleFontWeight": 600},
            },
        }
        try:
            st.vega_lite_chart(source, spec, width="stretch", theme=None)
        except TypeError:
            try:
                st.vega_lite_chart(source, spec, use_container_width=True, theme=None)
            except TypeError:
                st.vega_lite_chart(source, spec, use_container_width=True)
    except Exception:
        # Keep every page usable if a specific dataset contains an unsupported
        # value or the installed Streamlit version lacks a newer Altair option.
        kwargs = {"x": x_col, "y": y_col}
        if color_col and color_col in df.columns:
            kwargs["color"] = color_col
        native = {
            "line": st.line_chart, "bar": st.bar_chart,
            "area": st.area_chart, "scatter": st.scatter_chart,
        }.get(chart_type, st.line_chart)
        try:
            native(df, height=height, **kwargs)
        except TypeError:
            try:
                native(df, **kwargs)
            except Exception:
                show_table(df, height=height)
        except Exception:
            show_table(df, height=height)

def _read_user_security_context():
    """Returns (display_name, primary_role, tier)."""
    if is_demo():
        role = st.session_state.get("demo_role", "ADMIN")
        return "Demo User", f"FINOPS_{role}", role
    def pretty(raw):
        s = str(raw or "").strip()
        if not s:
            return "User"
        # RAHUL.P -> Rahul P ; jane_doe -> Jane Doe
        parts = [p for p in s.replace("_", " ").replace(".", " ").split() if p]
        return " ".join(p.capitalize() for p in parts) if parts else s

    try:
        _conn = get_snowflake_conn()
        ctx = _conn.query("""
            SELECT CURRENT_USER() AS USER_NAME,
                   CURRENT_ROLE() AS PRIMARY_ROLE,
                   CURRENT_AVAILABLE_ROLES() AS ALL_ROLES
        """, ttl=0)
        if ctx is not None and not ctx.empty:
            uname = pretty(ctx["USER_NAME"].iloc[0])
            primary = str(ctx["PRIMARY_ROLE"].iloc[0])
            import json
            raw_roles = ctx["ALL_ROLES"].iloc[0]
            all_roles = set(json.loads(raw_roles) if isinstance(raw_roles, str) else raw_roles)
            if "ACCOUNTADMIN" in all_roles or "FINOPS_ADMIN" in all_roles:
                return uname, primary, "ADMIN"
            if "DATA_ENGINEER" in all_roles or "SYSADMIN" in all_roles:
                return uname, primary, "ENGINEER"
            return uname, primary, "VIEWER"
        return "User", "PUBLIC", "VIEWER"
    except Exception:
        # Fallback: try simpler queries individually
        try:
            _conn = get_snowflake_conn()
            fallback = _conn.query("SELECT CURRENT_USER() AS U, CURRENT_ROLE() AS R", ttl=0)
            if fallback is not None and not fallback.empty:
                return pretty(fallback["U"].iloc[0]), str(fallback["R"].iloc[0]), "VIEWER"
        except Exception:
            pass
        return "User", "PUBLIC", "VIEWER"

def get_user_security_context(fresh=False):
    """Cache display context briefly; every state change reads roles uncached."""
    if is_demo():
        return _read_user_security_context()
    now = time.monotonic()
    cached = st.session_state.get("_finops_display_security")
    if not fresh and cached and cached["expires"] > now:
        return tuple(cached["value"])
    value = _read_user_security_context()
    previous = st.session_state.get("_finops_security_fingerprint")
    fingerprint = tuple(value)
    if previous != fingerprint:
        st.session_state.pop("_finops_session_cache", None)
        st.session_state.pop("_finops_profile_cache", None)
    st.session_state["_finops_security_fingerprint"] = fingerprint
    st.session_state["_finops_display_security"] = {"value": fingerprint, "expires": now + 60}
    return value


def execute_resource_action(object_type, name_parts, action):
    """Hard read-only boundary: this analytics product never changes Snowflake resources."""
    raise PermissionError("Resource actions are disabled in this read-only dashboard.")
    # Retained below only as unreachable legacy context until post-development cleanup.
    if get_user_security_context(fresh=True)[2] == "VIEWER":
        raise PermissionError("Unable to verify an authorized user role for this action.")
    if is_demo():
        st.session_state.setdefault("demo_actions", []).append((object_type, name_parts, action))
        return
    if object_type not in ("WAREHOUSE", "COMPUTE POOL", "SERVICE") or action not in ("SUSPEND", "RESUME"):
        raise ValueError("Unsupported resource action")
    required_parts = 3 if object_type == "SERVICE" else 1
    if len(name_parts) != required_parts or any(not str(part).strip() or str(part) == "None" for part in name_parts):
        raise ValueError("A verified, fully qualified resource name is required.")
    identifier = ".".join('"' + str(part).replace('"', '""') + '"' for part in name_parts)
    with get_snowflake_conn().cursor() as cursor:
        cursor.execute(f"ALTER {object_type} IDENTIFIER(%s) {action}", (identifier,))
    refresh_data()
