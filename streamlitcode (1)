            safe_render_chart("bar", axis_label(by_p, {proj_col: "Project", c_col: "Credits (view sum)"}),
                              ["Project"], ["Credits (view sum)"])
    else:
        empty_state("No VW_CHARGEBACK rows. Apply warehouse tags (COST_CENTER, TEAM, PROJECT) and rebuild the view.")

    st.markdown("#### Billed vs used")
    period_note(
        "METERING_DAILY_HISTORY: cloud services only invoice when they exceed ~10% of compute. "
        "CREDITS_USED is metering; CREDITS_BILLED is after the adjustment. Not lifetime."
    )
    if not df_bill.empty:
        used = safe_num(df_bill.get("CREDITS_USED", pd.Series(dtype=float)).sum()) if "CREDITS_USED" in df_bill.columns else 0
        billed = safe_num(df_bill.get("CREDITS_BILLED", pd.Series(dtype=float)).sum()) if "CREDITS_BILLED" in df_bill.columns else 0
        adj = safe_num(df_bill.get("CLOUD_SERVICES_ADJUSTMENT", pd.Series(dtype=float)).sum()) if "CLOUD_SERVICES_ADJUSTMENT" in df_bill.columns else 0
        b1, b2, b3 = st.columns(3)
        with b1:
            kpi("Metered · view sum", f"{used:,.1f} cr", period="CREDITS_USED before the cloud-services rebate.")
        with b2:
            kpi("Billed · view sum", f"{billed:,.1f} cr", period="Metered plus CLOUD_SERVICES_ADJUSTMENT (usually negative).")
        with b3:
            kpi("Cloud services rebate", f"{adj:,.1f} cr", period="Negative means those cloud-services credits were not invoiced.")
        dcol = get_best_col(df_bill, ["USAGE_DATE"])
        if dcol and "CREDITS_USED" in df_bill.columns and "CREDITS_BILLED" in df_bill.columns:
            daily = df_bill.groupby(dcol, as_index=False)[["CREDITS_USED", "CREDITS_BILLED"]].sum()
            daily = axis_label(daily, {dcol: "Date", "CREDITS_USED": "Metered credits", "CREDITS_BILLED": "Billed credits"})
            safe_render_chart("line", daily, ["Date"], ["Metered credits", "Billed credits"], multi_y=True)
    else:
        empty_state("No VW_BILLED_VS_USED rows.")


