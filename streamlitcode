# --- SAFE NUMERIC CONVERSION HELPERS ---
def safe_num(val, default=0.0):
    """Safely converts any value (Decimal, string, series sum, None) to float."""
    try:
        if val is None or pd.isna(val):
            return default
        if isinstance(val, (pd.Series, pd.Index)):
            val = pd.to_numeric(val, errors="coerce").sum()
        return float(val)
    except Exception:
        return default

@st.cache_data(ttl=600)
def run_query(view_name):
    try:
        _conn = st.connection("snowflake")
        df = _conn.query(f"SELECT * FROM {SCHEMA}.{view_name}")
        if df is None or df.empty:
            return pd.DataFrame()

        for col in df.columns:
            # Datetime detection MUST run before numeric coercion, otherwise
            # pd.to_numeric turns timestamps into epoch nanoseconds.
            if pd.api.types.is_datetime64_any_dtype(df[col]):
                has_time = False
                try:
                    has_time = bool((df[col].dt.hour.fillna(0) != 0).any() or
                                    (df[col].dt.minute.fillna(0) != 0).any())
                except Exception:
                    has_time = False
                df[col] = df[col].dt.strftime("%Y-%m-%d %H:%M" if has_time else "%Y-%m-%d")
                df[col] = df[col].fillna("")
                continue

            if df[col].dtype == "object":
                sample = df[col].dropna().head(20)
                if len(sample) > 0 and sample.apply(lambda x: hasattr(x, "strftime")).all():
                    df[col] = df[col].apply(
                        lambda x: x.strftime("%Y-%m-%d") if hasattr(x, "strftime") else ("" if x is None else str(x))
                    )
                    continue
                # Quoted date strings coming back as '"""2026-08-11"""'
                stripped = df[col].astype(str).str.replace('"', '', regex=False).str.strip()
                if len(sample) > 0:
                    probe = pd.to_datetime(stripped, errors="coerce")
                    if probe.notna().mean() > 0.8:
                        has_time = False
                        try:
                            has_time = bool((probe.dt.hour.fillna(0) != 0).any() or
                                            (probe.dt.minute.fillna(0) != 0).any())
                        except Exception:
                            has_time = False
                        df[col] = probe.dt.strftime("%Y-%m-%d %H:%M" if has_time else "%Y-%m-%d").fillna("")
                        continue

            try:
                numeric_series = pd.to_numeric(df[col], errors="coerce")
                if not numeric_series.isna().all():
                    df[col] = numeric_series.fillna(0.0)
                    continue
            except Exception:
                pass

            if df[col].dtype == "object":
                df[col] = df[col].fillna("").astype(str)
        return df
    except Exception:
        return pd.DataFrame()


