def sev_delta(col_name):
    """Universal convention: red when a cost/waste metric rises, green when a
    quality metric rises. Returns a value for st.metric(delta_color=...)."""
    u = str(col_name).upper()
    if any(k in u for k in _HIGH_IS_GOOD):
        return "normal"
    if any(k in u for k in _HIGH_IS_BAD):
        return "inverse"
    return "off"


def fmt_month(df, cols=None):
    """Renders month columns as MM/YYYY."""
    if df is None or df.empty:
        return df
    df = df.copy()
    targets = cols if cols else [c for c in df.columns if c.upper() in ("MONTH", "MONTH_START", "ORDER_MONTH")]
    for col in targets:
        if col not in df.columns:
            continue
        try:
            raw = df[col].astype(str).str.replace('"', '', regex=False).str.strip()
            parsed = pd.to_datetime(raw, errors="coerce")
            if parsed.notna().any():
                df[col] = parsed.dt.strftime("%m/%Y").fillna("")
        except Exception:
            pass
    return df


def show_table(df, height=None):
