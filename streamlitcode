with tab_remediation:
    st.markdown("### Remediation & Action Console")

    if user_tier == "VIEWER":
        st.info("Read-only view. State changes require DATA_ENGINEER or FINOPS_ADMIN role.")

    _conn = st.connection("snowflake")

    def pick(row, *names):
        """Reads a value from a SHOW result row regardless of column casing."""
        for n in names:
            for variant in (n, n.lower(), n.upper()):
                if variant in row.index:
                    val = row[variant]
                    if val is not None:
                        return val
        return None

    st.markdown("#### Warehouse Fleet Status")
    df_wh_status = None
    try:
        df_wh_status = _conn.query("SHOW WAREHOUSES")
    except Exception as ex:
        st.error(f"Unable to read warehouse state: {ex}")

    if df_wh_status is not None and not df_wh_status.empty:
        started = 0
        suspended = 0
        long_suspend = []

        for _, wh in df_wh_status.iterrows():
            state = str(pick(wh, "state") or "").upper()
            if state == "STARTED":
                started += 1
            elif state == "SUSPENDED":
                suspended += 1
            asp = pick(wh, "auto_suspend")
            try:
                if asp is not None and float(asp) > 120:
                    long_suspend.append((str(pick(wh, "name")), int(float(asp))))
            except Exception:
                pass

        cs1, cs2, cs3 = st.columns(3)
        with cs1:
            st.metric("Total Warehouses", len(df_wh_status))
        with cs2:
            st.metric("Currently Running", started,
                      delta="Billing now" if started > 0 else "All idle",
                      delta_color="inverse" if started > 0 else "normal")
        with cs3:
            st.metric("Suspended", suspended)

        st.markdown("")
        for _, wh in df_wh_status.iterrows():
            wh_name = str(pick(wh, "name") or "")
            wh_state = str(pick(wh, "state") or "UNKNOWN").upper()
            wh_size = str(pick(wh, "size") or "-")
            wh_asp = pick(wh, "auto_suspend")
            wh_running = pick(wh, "running")
            wh_queued = pick(wh, "queued")

            if not wh_name:
                continue

            badge = "RUNNING" if wh_state == "STARTED" else wh_state
            ca, cb, cc = st.columns([4, 2, 1])
            with ca:
                st.write(f"**{wh_name}** — `{badge}`")
                st.caption(
                    f"Size: {wh_size} | Auto-suspend: {wh_asp}s | "
                    f"Running: {wh_running} | Queued: {wh_queued}"
                )
            with cb:
                if wh_state == "STARTED":
                    st.caption("Consuming credits")
                else:
                    st.caption("No cost while suspended")
            with cc:
                if user_tier == "VIEWER":
                    st.caption("—")
                elif wh_state == "STARTED":
                    if st.button("Suspend", key=f"sus_wh_{wh_name}", type="primary"):
                        try:
