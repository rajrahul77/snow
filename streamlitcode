# 18. ML FORECAST
# ==============================================================================
with tab_forecast:
    st.markdown("### ML-Powered Spend Forecast")
    st.caption("Generated by SNOWFLAKE.ML.FORECAST trained on your historical daily warehouse consumption.")

    df_fc = run_query("ML_SPEND_FORECAST")
    df_burn_fc = run_query("VW_BUDGET_BURNDOWN")

    if not df_fc.empty:
        df_fc = clean_dates(df_fc, ["FORECAST_DATE"])
        df_fc = df_fc.sort_values("FORECAST_DATE")

        total_pred = safe_num(df_fc["PREDICTED_CREDITS"].sum())
        avg_daily = safe_num(df_fc["PREDICTED_CREDITS"].mean())
        worst_case = safe_num(df_fc["PESSIMISTIC_SPEND"].sum())
        best_case = safe_num(df_fc["OPTIMISTIC_SPEND"].sum())
        peak_day = df_fc.loc[df_fc["PREDICTED_CREDITS"].idxmax()]

        # Confidence band width = volatility indicator
        band_width = safe_num((df_fc["PESSIMISTIC_SPEND"] - df_fc["OPTIMISTIC_SPEND"]).mean())
        volatility = "High" if band_width > avg_daily * 4 else ("Moderate" if band_width > avg_daily * 2 else "Low")

        # Trend direction: compare first vs last third of the horizon
        third = max(1, len(df_fc) // 3)
        early = safe_num(df_fc["PREDICTED_CREDITS"].head(third).mean())
        late = safe_num(df_fc["PREDICTED_CREDITS"].tail(third).mean())
        if early > 0:
            trend_pct = ((late - early) / early) * 100
        else:
            trend_pct = 0
        trend_label = "Rising" if trend_pct > 5 else ("Declining" if trend_pct < -5 else "Flat")

        # Compare against actual recent spend
        actual_30d = None
        if not df_burn_fc.empty:
            mtd_c = get_best_col(df_burn_fc, ["MTD_CREDITS", "MTD_SPEND"])
            if mtd_c:
                actual_30d = safe_num(df_burn_fc[mtd_c].iloc[-1])

        cf1, cf2, cf3, cf4 = st.columns(4)
        with cf1:
            delta_txt = None
            if actual_30d and actual_30d > 0:
                diff = ((total_pred - actual_30d) / actual_30d) * 100
                delta_txt = f"{diff:+.1f}% vs MTD actual"
            st.metric("Forecast Total", f"{total_pred:,.2f} cr", delta=delta_txt, delta_color="inverse")
        with cf2:
            st.metric("Daily Run Rate", f"{avg_daily:,.3f} cr",
                      delta=f"{trend_label} ({trend_pct:+.1f}%)",
                      delta_color="inverse" if trend_pct > 5 else "normal")
        with cf3:
            st.metric("Worst Case", f"{worst_case:,.2f} cr",
                      delta=f"Best: {max(best_case, 0):,.2f} cr", delta_color="off")
        with cf4:
            st.metric("Forecast Confidence", volatility + " variance",
                      delta=f"±{band_width / 2:,.2f} cr/day", delta_color="off")

        st.markdown("")
        cs1, cs2, cs3 = st.columns(3)
        with cs1:
            st.metric("Horizon", f"{len(df_fc)} days")
        with cs2:
            st.metric("Peak Day", str(peak_day["FORECAST_DATE"]),
                      delta=f"{safe_num(peak_day['PREDICTED_CREDITS']):,.3f} cr", delta_color="off")
        with cs3:
            st.metric("Forecast Window",
                      f"{df_fc['FORECAST_DATE'].iloc[0]} → {df_fc['FORECAST_DATE'].iloc[-1]}")

        if volatility == "High":
            st.warning(
                "**Wide confidence band.** Your historical usage is highly variable (intermittent workloads), "
                "so treat the central prediction as a directional signal rather than a precise number. "
                "The worst-case bound is the safer figure for budget planning."
            )
        if trend_pct > 10:
            st.error(f"**Spend trending up {trend_pct:.1f}%** across the forecast horizon. Review new workloads.")
        elif trend_pct < -10:
            st.success(f"Spend trending down {abs(trend_pct):.1f}% — recent optimizations are taking effect.")

        fc_grain = drill_control("fc_grain", default="Date")

        st.markdown(f"#### Predicted Spend with Confidence Band by {fc_grain}")
        chart_df = df_fc[["FORECAST_DATE", "OPTIMISTIC_SPEND", "PREDICTED_CREDITS", "PESSIMISTIC_SPEND"]].copy()
        chart_df = apply_drill(
            chart_df, "FORECAST_DATE",
            ["OPTIMISTIC_SPEND", "PREDICTED_CREDITS", "PESSIMISTIC_SPEND"], fc_grain,
            drill_key="fc_grain"
        )
        chart_df = chart_df.rename(columns={
            "FORECAST_DATE": fc_grain,
            "OPTIMISTIC_SPEND": "Best Case",
            "PREDICTED_CREDITS": "Predicted",
            "PESSIMISTIC_SPEND": "Worst Case",
        })
        safe_render_chart("line", chart_df, [fc_grain],
                          ["Predicted", "Best Case", "Worst Case"], multi_y=True)

        col_fc1, col_fc2 = st.columns(2)
        with col_fc1:
            st.markdown(f"#### Predicted Consumption by {fc_grain}")
            bar_fc = apply_drill(df_fc, "FORECAST_DATE", ["PREDICTED_CREDITS"], fc_grain, drill_key="fc_grain_bar")
            bar_fc = axis_label(bar_fc, {"FORECAST_DATE": fc_grain, "PREDICTED_CREDITS": "Credits"})
            safe_render_chart("bar", bar_fc, [fc_grain], ["Credits"])
        with col_fc2:
            st.markdown("#### Cumulative Projected Spend")
            cum_df = df_fc[["FORECAST_DATE"]].copy()
            cum_df["Cumulative Credits"] = df_fc["PREDICTED_CREDITS"].cumsum().round(3)
            cum_df = cum_df.rename(columns={"FORECAST_DATE": "Date"})
            safe_render_chart("area", cum_df, ["Date"], ["Cumulative Credits"])

        st.markdown("#### Detailed Forecast")
        display_fc = df_fc.rename(columns={
            "FORECAST_DATE": "Date",
            "PREDICTED_CREDITS": "Predicted Credits",
            "OPTIMISTIC_SPEND": "Best Case",
            "PESSIMISTIC_SPEND": "Worst Case",
        })
        show_table(display_fc)

        with st.expander("How to read this forecast"):
            st.markdown("""
- **Predicted Credits** — the model's central estimate for that day.
- **Best / Worst Case** — the 95% prediction interval. Actual spend should fall inside this band.
- **Negative best-case values** are a statistical artifact of high variance in the training data;
  read them as "effectively zero" rather than a credit refund.
- **For budgeting**, use the *Worst Case* total. For *expected* cost, use the Predicted total.
- The model retrains only when you re-run `CREATE SNOWFLAKE.ML.FORECAST`. Refresh it periodically
  (or via a scheduled Task) so predictions reflect recent behaviour.
            """)
    else:
        st.caption("No ML forecast data available. Train COST_FORECASTER to generate predictions.")
